<node id="form:goal-list"><data key="type">FeedbackForm</data><data key="label">Goal or subgoal list</data><data key="props">{}</data></node>
<node id="form:skill-chain"><data key="type">FeedbackForm</data><data key="label">Skill chain</data><data key="props">{}</data></node>
