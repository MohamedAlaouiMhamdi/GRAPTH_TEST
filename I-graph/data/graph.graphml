<node id="experiment:P013-2"><data key="type">Experiment</data><data key="label">AutoSkill · Sim-to-real transfer</data><data key="props">{"workId": "work:lin_autoskill_2025", "evidenceId": "P013-2", "sourceId": "P013", "sourceUrl": "https://ieeexplore.ieee.org/document/10924760", "locator": "Section IV.C and Figure 10; Section V conclusion, PDF pages 9–10.", "reviewedAt": "2026-11-24", "reviewStatus": "Fresh targeted primary method/initialization check on 24 November; existing results and evaluation audit reused", "teacher": "fm", "providers": ["fm"], "decision": "include", "scopeLabel": "New-policy RL", "setting": "Sim-to-real transfer", "settingGroup": "Sim-to-real transfer", "task": "Hammer Cleanup and Stack Three", "taskFamily": "Object manipulation / skill composition", "platform": "Physical UR3", "feedbackSource": "Same AutoSkill reward system used during preceding simulated skill acquisition.", "feedback": "Binary success plus scalar event/progress reward during training in simulation.", "levels": ["Rating"], "channel": "", "model": "Same AutoSkill reward system used during preceding simulated skill acquisition.", "algorithm": "Modified SAC during the simulation stage.", "objective": "The policies are trained in simulation using model-generated rewards, then transferred for physical execution. The paper does not demonstrate reward-driven policy updates on the UR3.", "policyInitialization": "IV.C transfers the simulation-trained primitive-parameter policies to UR3; conclusion leaves online hardware adaptation to future work.", "integration": "The policies are trained in simulation using model-generated rewards, then transferred for physical execution. The paper does not demonstrate reward-driven policy updates on the UR3.", "comparison": "No controlled hardware ablation isolating foundation-model reward is reported in this section.", "result": "100% Hammer Cleanup success and 60% Stack Three success.", "finding": "10/10 and 6/10 transfer trials; supplied controllers and skill library.", "evaluation": "Ten physical trials per task.", "participants": "", "extraSupport": "Access to a simulation of the target task and transfer-compatible primitive/control structure.", "limitations": "Small controlled hardware evaluation. The conclusion explicitly identifies online adaptation to real-world tasks as future work. Do not call the UR3 experiment real-robot RL training.", "scopeReason": "The newly learned simulated skill policies are executed on UR3. Transfer is eligible evidence for the first category; no hardware fine-tuning is claimed.", "uncertainties": ["The IEEE webpage required JavaScript, so substantive verification used the supplied final journal PDF. Exact primitive-controller transfer implementation is less fully specified than the simulation RL method; do not infer additional on-hardware adaptation."]}</data></node>
