<node id="experiment:P002-1"><data key="type">Experiment</data><data key="label">Hybrid COACH · Real-robot training</data><data key="props">{"workId": "work:celemin_fast_2019", "evidenceId": "P002-1", "sourceId": "P002", "sourceUrl": "https://doi.org/10.1007/s10514-018-9786-6", "locator": "4.2.3, Fig 12", "reviewedAt": "2026-11-24", "reviewStatus": "2026-11-24 targeted local primary-text method/initialization check; detailed outcomes/protocol retained from 2026-11-23 primary audit.", "teacher": "human", "providers": ["human"], "decision": "include", "scopeLabel": "New-policy RL", "setting": "Real-robot training", "settingGroup": "Real-robot training", "task": "Inverse kinematics: reaching requested 3D targets", "taskFamily": "Reaching and positioning", "platform": "Physical 3-DoF arm", "feedbackSource": "Real human teachers", "feedback": "Signed joint/action corrections", "levels": ["Action"], "channel": "Keyboard", "model": "", "algorithm": "Simultaneous COACH + cost-based policy search", "objective": "Hybrid corrective learning and black-box cost-based policy search; arm objective is inverse-kinematics position error, not a demonstrated long-horizon manipulation return.", "policyInitialization": "The experiment teaches its own task mapping with COACH and/or cost-based policy search. The sequential variant first obtains a policy through corrective teaching within this experiment, then refines it with PS; the simultaneous variant interleaves both. A separately pretrained policy is used only for the artificial teacher in a different benchmark. Exact numeric initial arm-policy weights are not stated in the inspected passage.", "integration": "Corrective updates and task-cost optimization train mapping on physical robot", "comparison": "Pure COACH; pure policy search; sequential/simultaneous hybrids", "result": "Hybrid comparison, including a sequential variant: Hybrid methods reduce error by roughly 40% relative to COACH, with a mean of about 7 mm; plain policy search becomes trapped in local minima.", "finding": "Learns an IK mapping; sequential-refinement results are not isolated.", "evaluation": "Training rollout curves; independent held-out evaluation count not established", "participants": "Five participants stated for Section 4.2; allocation to the arm experiment is unclear.", "extraSupport": "", "limitations": "Learns an inverse-kinematics mapping. Human depth perception is imperfect; participant counts per arm condition are incompletely specified.", "scopeReason": "Retain the simultaneous/hybrid task-learning experiment as cost-based policy search with corrective feedback. Sequential COACH-then-PS refinement is a separately described stage, not evidence that every stage starts from a new actor.", "uncertainties": ["Hybrid policy-search inclusion does not establish sequential manipulation planning; arm target is an IK mapping. Sequential and simultaneous variants should be explained separately."]}</data></node>
