<node id="experiment:P043-1"><data key="type">Experiment</data><data key="label">ECLAIR · Physical feedback learning</data><data key="props">{"workId": "work:tarakli_interactive_2024", "evidenceId": "P043-1", "sourceId": "P043", "sourceUrl": "https://doi.org/10.1109/IROS58592.2024.10803055", "locator": "IV, V-C, VI-A, Fig 3", "reviewedAt": "2026-11-24", "reviewStatus": "2026-11-24 targeted local primary-text method/initialization check; detailed outcomes/protocol retained from 2026-11-23 primary audit.", "teacher": "human", "providers": ["human"], "decision": "related_learning", "scopeLabel": "Related learning", "setting": "Physical feedback learning", "settingGroup": "Other physical learning", "task": "Navigate to a cube, pick it up and place it at a destination", "taskFamily": "Navigation and object handling", "platform": "Physical Vector tabletop robot", "feedbackSource": "Live human speech interpreted by an LLM", "feedback": "Ratings, action corrections and next-action guidance", "levels": ["Rating", "Action"], "channel": "Speech through Whisper and an LLM; button-feedback baseline", "model": "", "algorithm": "ECLAIR; called Q-learning, but the displayed update fits human labels", "objective": "Direct fitting of human evaluation labels and execution of advice; conventional Bellman target underreported.", "policyInitialization": "Learns values from interpreted human labels and executes supplied next-action advice. LLM/Whisper are language-processing components, not an imported robot policy. A bootstrapped RL target is not established.", "integration": "Values move toward human labels; next-action advice is executed directly. A conventional Bellman update is not established by the displayed specification.", "comparison": "TAMER buttons versus ECLAIR speech with multiple feedback types", "result": "Reports faster teaching-session performance and higher success than the TAMER condition.", "finding": "Reports faster teaching-session performance and higher success than the TAMER condition.", "evaluation": "Eight episodes per condition per person; 18 hours of data collection reported.", "participants": "12 recruited; Figure 3 reports n = 10 without explanation.", "extraSupport": "", "limitations": "Interface, available feedback and decoding all change. Training performance includes advice; separate autonomous held-out testing is not established. Task-score penalties do not establish their use as learning rewards.", "scopeReason": "Retain as clearly labelled contextual evidence within interactive learning; its objective or feedback role differs from sequential task-return RL. This is not a recommendation to delete it from the survey.", "uncertainties": ["Participant discrepancy (12 versus 10) confirmed in Figure 3.", "A separate environment reward and Bellman update are not established.", "Figure 1 caption describes an unrelated offline inverse-RL pipeline; do not infer that it was used."]}</data></node>
