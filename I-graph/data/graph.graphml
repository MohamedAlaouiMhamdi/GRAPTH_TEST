<node id="experiment:P028-1"><data key="type">Experiment</data><data key="label">FuRL · Simulation</data><data key="props">{"workId": "work:fu_furl_2024", "evidenceId": "P028-1", "sourceId": "P028", "sourceUrl": "https://arxiv.org/html/2406.00645v2", "locator": "Sections 3.1–3.2 and Algorithm 1; Sections 5.2–5.4; Tables 1–2.", "reviewedAt": "2026-11-24", "reviewStatus": "Fresh targeted primary method/initialization check on 24 November; existing results and evaluation audit reused", "teacher": "fm", "providers": ["fm"], "decision": "include", "scopeLabel": "New-policy RL", "setting": "Simulation", "settingGroup": "Simulation", "task": "Ten reaching/manipulation tasks including pushing, drawers, door, windows, button pressing, peg insertion and pick-and-place.", "taskFamily": "Object manipulation", "platform": "Simulated Sawyer arm in Meta-World MT10", "feedbackSource": "Frozen LIV backbone with learned image and language projection heads; CLIP is also investigated.", "feedback": "Scalar similarity-derived reward.", "levels": ["Rating"], "channel": "", "model": "Frozen LIV backbone with learned image and language projection heads; CLIP is also investigated.", "algorithm": "SAC for state observations; DrQ for the pixel-input experiment.", "objective": "The main agent learns from sparse environment success reward plus weighted VLM reward. An auxiliary SAC policy uses only environment reward; relay exploration shares experience between policies. Successful and unsuccessful trajectories align reward projection heads.", "policyInitialization": "Algorithm 1 initializes image/text projections, VLM agent and auxiliary SAC agent. Section 3.2 trains both with a shared replay buffer.", "integration": "The main agent learns from sparse environment success reward plus weighted VLM reward. An auxiliary SAC policy uses only environment reward; relay exploration shares experience between policies. Successful and unsuccessful trajectories align reward projection heads.", "comparison": "Sparse SAC, unadapted VLM rewards, LIV, random projection, relay exploration, and reward-alignment ablations.", "result": "Fixed-goal MT10 mean final success is reported as 76% for FuRL versus 37% for sparse-reward SAC. Both FuRL and baselines fail on peg insertion and pick-and-place in this setup. The pixel window-opening experiment learns faster than DrQ.", "finding": "76% vs 37% mean in one setup; two tasks fail and task rewards remain.", "evaluation": "One million environment steps; five random seeds; final success-rate evaluation for fixed and random goals.", "participants": "", "extraSupport": "Sparse ground-truth success reward, task text, and a goal image in the main variant; a no-goal-image variant is evaluated.", "limitations": "Simulation only; VLM feedback complements a task-success oracle rather than removing all engineered task rewards. Improvements combine reward alignment and relay exploration. The 76% figure is a mean across ten fixed-goal benchmark tasks, not a real-robot success rate.", "scopeReason": "Both task actors are initialized for learning in the algorithm. Frozen LIV features and trained reward projections are not a pretrained action policy.", "uncertainties": ["No physical experiment or sim-to-real transfer reported."]}</data></node>
<node id="experiment-task:P028-1"><data key="type">Task</data><data key="label">Ten reaching/manipulation tasks including pushing, drawers, door, windows, button pressing, peg insertion and pick-and-place.</data><data key="props">{"experimentId": "P028-1", "taskFamily": "Object manipulation"}</data></node>
<node id="experiment:P052-1"><data key="type">Experiment</data><data key="label">MARVL · Simulation</data><data key="props">{"workId": "work:zhou_marvl_2026", "evidenceId": "P052-1", "sourceId": "P052", "sourceUrl": "https://arxiv.org/abs/2602.15872", "locator": "Equation 1; Sections 3 and 4; Figure 6; Appendix B.1–B.4, C.1–C.3; hyperparameter tables.", "reviewedAt": "2026-11-24", "reviewStatus": "Fresh targeted primary method/initialization check on 24 November; existing results and evaluation audit reused", "teacher": "fm", "providers": ["fm"], "decision": "include", "scopeLabel": "New-policy RL", "setting": "Simulation", "settingGroup": "Simulation", "task": "Eight Meta-World manipulation tasks, including pushing, buttons, doors, drawers and windows; additional Panda-Gym manipulation generalization.", "taskFamily": "Object manipulation", "platform": "Sawyer arm in Meta-World and Franka Panda in Panda-Gym", "feedbackSource": "CLIP ViT-B/32 adapted for scene/view decomposition; Qwen-3-Flash and Qwen-ImageEditPlus supply subgoals and target images in the automated variant.", "feedback": "Scalar similarity-derived, stage-dependent reward with confidence gating.", "levels": ["Rating"], "channel": "", "model": "CLIP ViT-B/32 adapted for scene/view decomposition; Qwen-3-Flash and Qwen-ImageEditPlus supply subgoals and target images in the automated variant.", "algorithm": "SAC; TD3 robustness experiment.", "objective": "The reward combines sparse task reward with a weighted visual-language shaping term. Adapted representations, stage target descriptions/images and task-direction projection shape progress; the resulting reward drives the RL actor and critic.", "policyInitialization": "Section 4 uses common state-based SAC; appendix hyperparameter table specifies 10,000 initial random-exploration steps. Pretrained/adapted CLIP supplies reward features.", "integration": "The reward combines sparse task reward with a weighted visual-language shaping term. Adapted representations, stage target descriptions/images and task-direction projection shape progress; the resulting reward drives the RL actor and critic.", "comparison": "Sparse SAC, LIV, FuRL, Relay, dense-reward oracle and component ablations.", "result": "Learning curves report stronger success and convergence than VLM-reward baselines across eight tasks; some tasks match or exceed the dense-reward oracle comparator. Robustness is tested with a different RL algorithm, cameras and Panda-Gym.", "finding": "Stronger tested learning curves; task rewards and reward adaptation remain.", "evaluation": "Main Meta-World curves average five random seeds; reported training budget is one million environment steps per task.", "participants": "", "extraSupport": "Sparse task reward; target stages/images specified manually in controlled experiments or generated by models; 500 simulator images with camera perturbations and known scene/view identities for representation adaptation.", "limitations": "All policy training and evaluation are simulated. Panda-Gym generalization is simulation-to-simulation, not sim-to-real. The abstract phrase about visual rewards must not erase the sparse task-reward term in the method setup. Generated goal quality and privileged simulator data remain qualifications.", "scopeReason": "Task-specific SAC/TD3 learns with adapted CLIP rewards. Initial random exploration and new actor/critic training are described; CLIP pretraining concerns feedback representation.", "uncertainties": ["The local paper does not independently establish the exact runtime frequency of encoder calls. Its current-state reward formulation is sufficient to establish reward-driven RL; do not overclaim implementation timing."]}</data></node>
