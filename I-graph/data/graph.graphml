<node id="experiment:S002-2"><data key="type">Experiment</data><data key="label">SEED · Physical feedback learning</data><data key="props">{"workId": "work:hiranaka_primitive_2023", "evidenceId": "S002-2", "sourceId": "S002", "sourceUrl": "https://arxiv.org/html/2307.15801v2", "locator": "§III.B Eq.1–3, III.D–E; IV.A; V Figs.6–7, TableII", "reviewedAt": "2026-11-24", "reviewStatus": "2026-11-24 targeted local primary-text method/initialization check; detailed outcomes/protocol retained from 2026-11-23 primary audit.", "teacher": "human", "providers": ["human"], "decision": "related_learning", "scopeLabel": "Related learning", "setting": "Physical feedback learning", "settingGroup": "Other physical learning", "task": "Sweeping toy into dustpan; toy into drawer then close; cooking-hotdog sequence", "taskFamily": "Manipulation and household tasks", "platform": "Physical Franka Emika Panda", "feedbackSource": "One person per task", "feedback": "Binary good/bad evaluation of a proposed skill and its parameters", "levels": ["Rating"], "channel": "Keyboard and annotated skill preview", "model": "", "algorithm": "SAC-style skill actors; TAMER-like supervised immediate-feedback critic", "objective": "Myopic learned-human-feedback optimization using skill/parameter actors; no bootstrapped return target.", "policyInitialization": "Algorithm 1 initializes skill actor, parameter actor and feedback critic. Skills are supplied primitives. The SEED critic learns immediate feedback; invoking SAC-style actor objectives does not establish Bellman RL.", "integration": "Skill and parameter policies updated live; can evaluate before execution; supervised myopic feedback critic, not Bellman return estimation", "comparison": "Low-level TAMER; MAPLE-aff only first hotdog subgoal", "result": "SEED learns all three within budgets; low-level TAMER has no complete task successes", "finding": "SEED learns all three within budgets; low-level TAMER has no complete task successes", "evaluation": "Two training trials/task; cumulative training successes, not held-out success rate", "participants": "One trainer/task, training twice; unique total unspecified", "extraSupport": "", "limitations": "Myopic feedback critic rather than standard Bellman SAC; affordance penalty and supplied primitives; safety denominators differ from low-level baseline; manual resets/emergency stops", "scopeReason": "Retain as clearly labelled contextual evidence within interactive learning; its objective or feedback role differs from sequential task-return RL. This is not a recommendation to delete it from the survey.", "uncertainties": [], "correction": "Binary good/bad feedback; supersedes the earlier ternary description."}</data></node>
