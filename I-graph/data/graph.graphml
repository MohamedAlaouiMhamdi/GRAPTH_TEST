<node id="task:frozenlake"><data key="type">Task</data><data key="label">FrozenLake</data><data key="props">{"kind": "named benchmark", "settings": ["sim"]}</data></node>
<node id="row:F17"><data key="type">TableRow</data><data key="label">Table II, row F17</data><data key="props">{"table": "II", "block": "Goal guidance", "order": 17, "nWorks": 1, "form": "Goal list", "integration": "Similarity → RS (MF)", "envReward": "Absent", "tasks": "Crafter, Housekeep (sim)", "model": "API LLM, frozen (Codex; text-davinci-002 on Housekeep) + SBERT", "input": "State caption (template or captioner)", "timing": "Own; every step, cached", "level": "Goal"}</data></node>
<node id="task:housekeep"><data key="type">Task</data><data key="label">Housekeep</data><data key="props">{"kind": "named benchmark", "settings": ["sim"]}</data></node>
<node id="row:F18"><data key="type">TableRow</data><data key="label">Table II, row F18</data><data key="props">{"table": "II", "block": "Goal guidance", "order": 18, "nWorks": 1, "form": "Subgoal list (targets)", "integration": "Subgoal reward → RS (MF), goal-conditioned", "envReward": "Present", "tasks": "MiniGrid (sim)", "model": "Open LLMs, frozen (Llama-3-70B)", "input": "Text grid of s₀", "timing": "None; per episode or once", "level": "Goal"}</data></node>
