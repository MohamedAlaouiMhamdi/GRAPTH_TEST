<node id="experiment:P090-1"><data key="type">Experiment</data><data key="label">VLM-RM · Simulation</data><data key="props">{"workId": "work:rocamonde_vision-language_2023", "evidenceId": "P090-1", "sourceId": "P090", "sourceUrl": "https://arxiv.org/html/2310.12921v2", "locator": "Section 4.3, Table 1, Figure 3; Appendix B; Appendix C.2.", "reviewedAt": "2026-11-24", "reviewStatus": "Fresh targeted primary method/initialization check on 24 November; existing results and evaluation audit reused", "teacher": "fm", "providers": ["fm"], "decision": "include", "scopeLabel": "New-policy RL", "setting": "Simulation", "settingGroup": "Simulation", "task": "Eight target poses: kneeling, lotus position, standing, arms raised, splits, hands on hips, standing on one leg, and arms crossed.", "taskFamily": "Humanoid posture control", "platform": "MuJoCo Humanoid-v4", "feedbackSource": "Frozen CLIP; largest model used for the principal humanoid experiments.", "feedback": "Scalar score derived from visual and textual embedding similarity.", "levels": ["Rating"], "channel": "", "model": "Frozen CLIP; largest model used for the principal humanoid experiments.", "algorithm": "SAC", "objective": "Rendered observations receive CLIP scores in periodic batches. Those scores replace the environment reward in replay and drive SAC actor and critic updates.", "policyInitialization": "Algorithm 1 initializes SAC and empty replay buffers; Appendix C.2 trains a two-layer MLP after 50,000 initial steps.", "integration": "Rendered observations receive CLIP scores in periodic batches. Those scores replace the environment reward in replay and drive SAC actor and critic updates.", "comparison": "Reward-model size, goal-baseline regularization, camera and texture modifications; no hardware comparison.", "result": "Five of eight poses reach 100% reported success; hands on hips reaches 64%; one-leg standing and arms crossed reach 0%.", "finding": "Five of eight poses reach reported 100%; best checkpoint across four seeds.", "evaluation": "Ten million simulator steps; highest-reward checkpoint selected across four seeds; 100 trajectories per task labelled by one rater. Episode success requires the target pose for about half the episode.", "participants": "", "extraSupport": "Language goal; some experiments use a baseline prompt. Human ratings are used for evaluation, not policy-training rewards.", "limitations": "Single-rater, coarse pose evaluation and selected checkpoint; modified textures and camera help CLIP. No physical robot training or transfer. CartPole and MountainCar are separate control benchmarks, not counted as robot applications.", "scopeReason": "CLIP is a pretrained evaluator, while a new SAC task actor is trained to realize humanoid poses.", "uncertainties": ["No independent replication. Main text and appendix phrase the 50%-of-steps success threshold slightly differently; do not treat the reported rate as precise physical pose reliability."]}</data></node>
