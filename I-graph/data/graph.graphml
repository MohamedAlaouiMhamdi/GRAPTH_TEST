<node id="experiment:P085-2"><data key="type">Experiment</data><data key="label">T2-VLM · Feedback evaluation only</data><data key="props">{"workId": "work:zhao_training-free_2025", "evidenceId": "P085-2", "sourceId": "P085", "sourceUrl": "https://arxiv.org/html/2507.04789v1", "locator": "Section 4.4 and Table 4; conclusion; Appendix C.1; Figure 8.", "reviewedAt": "2026-11-24", "reviewStatus": "Fresh targeted primary method/initialization check on 24 November; existing results and evaluation audit reused", "teacher": "fm", "providers": ["fm"], "decision": "evaluation_only", "scopeLabel": "Feedback evaluation only", "setting": "Feedback evaluation only", "settingGroup": "Feedback evaluation only", "task": "Two real-world tabletop manipulation tasks; additional occluded-object sorting illustration.", "taskFamily": "Object manipulation / skill selection", "platform": "Physical UR arm workspace with a top-down camera", "feedbackSource": "Qwen2-VL variants and Claude 3.5 Sonnet in comparative reward evaluation; SAM2 and particle filtering.", "feedback": "Tracked subgoal status and derived reward.", "levels": ["Rating"], "channel": "", "model": "Qwen2-VL variants and Claude 3.5 Sonnet in comparative reward evaluation; SAM2 and particle filtering.", "algorithm": "None demonstrated for the physical evaluation.", "objective": "No physical policy-training loop is established. Hardware observations are used to assess reward accuracy, inference time and model-query counts.", "policyInitialization": "Not applicable to the reported physical reward-assessment experiment. See cited method/experiment sections in the 23 November audit.", "integration": "No physical policy-training loop is established. Hardware observations are used to assess reward accuracy, inference time and model-query counts.", "comparison": "Direct repeated VLM scoring versus T2-VLM under different foundation models.", "result": "Physical tables compare reward accuracy, inference time and query counts; these are feedback-system outcomes, not physical policy-success gains.", "finding": "Physical tables compare reward accuracy, inference time and query counts; these are feedback-system outcomes, not physical policy-success gains.", "evaluation": "Section 4.4 and Table 4; physical evaluation is distinct from the simulated training environments in Appendix C.1.", "participants": "", "extraSupport": "Task description and observed robot workspace.", "limitations": "Do not transfer simulated RL claims to the real robot. The phrase training-free refers to reward generation without task-training the VLM; the robot policy is still trained with RL in simulation.", "scopeReason": "The physical experiment measures reward accuracy and computation, without demonstrating a physical RL policy update.", "uncertainties": ["Physical task names are not fully specified in the passages retained for this targeted review; do not invent them. No hardware policy update is evidenced in the inspected methods and experiments."]}</data></node>
