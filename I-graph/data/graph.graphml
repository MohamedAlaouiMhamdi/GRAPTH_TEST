<node id="experiment:P008-1"><data key="type">Experiment</data><data key="label">Lafite-RL · Simulation</data><data key="props">{"workId": "work:chu_accelerating_2023", "evidenceId": "P008-1", "sourceId": "P008", "sourceUrl": "https://arxiv.org/html/2311.02379v1", "locator": "Section 3, equations 1–2; Section 4, Figure 4 and Table 2; Section 5.", "reviewedAt": "2026-11-24", "reviewStatus": "Fresh targeted primary method/initialization check on 24 November; existing results and evaluation audit reused", "teacher": "fm", "providers": ["fm"], "decision": "include", "scopeLabel": "New-policy RL", "setting": "Simulation", "settingGroup": "Simulation", "task": "Push buttons; take an umbrella out of its stand.", "taskFamily": "Object manipulation", "platform": "Franka Panda in RLBench", "feedbackSource": "Frozen Vicuna-13B v1.5", "feedback": "Binary good/bad motion evaluation, parsed as +1 or −1; zero is a parsing fallback.", "levels": ["Rating"], "channel": "", "model": "Frozen Vicuna-13B v1.5", "algorithm": "DreamerV3", "objective": "Every four environment timesteps, text descriptions of movement and scene geometry are evaluated by Vicuna. The parsed feedback reward is added to the sparse environment reward and supplied to DreamerV3 training.", "policyInitialization": "Section 4 specifies middle-size DreamerV3 with default settings, 200,000 task-training steps and three seeds. No external actor checkpoint or imitation initialization is stated.", "integration": "Every four environment timesteps, text descriptions of movement and scene geometry are evaluated by Vicuna. The parsed feedback reward is added to the sparse environment reward and supplied to DreamerV3 training.", "comparison": "Same DreamerV3 setup without the LLM feedback reward.", "result": "Reported final success: button pushing 70.3% versus 41.6%; umbrella removal 68.7% versus 26.1% for DreamerV3 without language feedback.", "finding": "Improves two-task success versus base learner; three seeds.", "evaluation": "Two tasks; 200,000 training steps; three random seeds; 100 evaluation episodes after learning.", "participants": "", "extraSupport": "Environment success reward, scaled to 100; manually designed task prompts; privileged scene coordinates, gripper state and distance API for the language evaluator.", "limitations": "Simulation only, two tasks, and access to geometric state information. The result supports added LLM feedback in this setup; it does not establish vision-only reward generation or physical-robot reliability.", "scopeReason": "Vicuna evaluates movements and augments rewards for task-specific DreamerV3 robot learning; no loaded pretrained robot actor is described.", "uncertainties": ["The paper does not claim physical-robot training or sim-to-real transfer."]}</data></node>
