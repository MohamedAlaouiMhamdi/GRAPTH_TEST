<?xml version="1.0" encoding="UTF-8"?>
<graphml xmlns="http://graphml.graphdrawing.org/xmlns">
<key id="type" for="all" attr.name="type" attr.type="string"/>
<key id="label" for="node" attr.name="label" attr.type="string"/>
<key id="props" for="all" attr.name="properties_json" attr.type="string"/>
<graph id="irl-survey" edgedefault="directed">
<node id="teacher:human"><data key="type">TeacherType</data><data key="label">Human</data><data key="props">{}</data></node>
<node id="teacher:fm"><data key="type">TeacherType</data><data key="label">Foundation model (LLM/VLM)</data><data key="props">{}</data></node>
<node id="teacherkind:people"><data key="type">TeacherKind</data><data key="label">People</data><data key="props">{"definition": "Feedback given by people through an interface or read from their reactions."}</data></node>
<node id="teacherkind:standin"><data key="type">TeacherKind</data><data key="label">Stand-in for people</data><data key="props">{"definition": "Simulated user or oracle, synthetic or scripted labels, recorded human feedback or an agent trainer used in place of a person (Table I, Channel column)."}</data></node>
<node id="ftype:evaluative"><data key="type">FeedbackType</data><data key="label">Evaluative</data><data key="props">{"definition": "The teacher judges a behavior it is shown (Section V)."}</data></node>
<node id="ftype:informative"><data key="type">FeedbackType</data><data key="label">Informative</data><data key="props">{"definition": "The teacher prescribes the behavior to perform (Section V)."}</data></node>
<node id="level:rating"><data key="type">FeedbackLevel</data><data key="label">Rating</data><data key="props">{"definition": "Judges one behavior on an absolute scale: binary, graded or ordered classes.", "feedbackType": "evaluative"}</data></node>
<node id="level:preference"><data key="type">FeedbackLevel</data><data key="label">Preference</data><data key="props">{"definition": "Compares two or more behaviors and says which is better.", "feedbackType": "evaluative"}</data></node>
<node id="level:action"><data key="type">FeedbackLevel</data><data key="label">Action</data><data key="props">{"definition": "Fixes the action or how to change it: an action, a correction or a rule.", "feedbackType": "informative"}</data></node>
<node id="level:goal"><data key="type">FeedbackLevel</data><data key="label">Goal</data><data key="props">{"definition": "Fixes only what to reach or act upon: a state, object, subgoal or skill.", "feedbackType": "informative"}</data></node>
<node id="chclass:explicit"><data key="type">ChannelClass</data><data key="label">Explicit</data><data key="props">{"definition": "Given on purpose through an interface or in words (human teachers only)."}</data></node>
<node id="chclass:implicit"><data key="type">ChannelClass</data><data key="label">Implicit</data><data key="props">{"definition": "Read from the teacher's reactions (face, voice, brain activity) by a perception model (human teachers only)."}</data></node>
<node id="integ:RS"><data key="type">IntegrationMethod</data><data key="label">Reward shaping</data><data key="props">{"code": "RS", "definedBy": "najar_reinforcement_2021"}</data></node>
<node id="integ:VS"><data key="type">IntegrationMethod</data><data key="label">Value shaping</data><data key="props">{"code": "VS", "definedBy": "najar_reinforcement_2021"}</data></node>
<node id="integ:PS"><data key="type">IntegrationMethod</data><data key="label">Policy shaping</data><data key="props">{"code": "PS", "definedBy": "najar_reinforcement_2021"}</data></node>
<node id="integ:DB"><data key="type">IntegrationMethod</data><data key="label">Decision biasing</data><data key="props">{"code": "DB", "definedBy": "najar_reinforcement_2021"}</data></node>
<node id="integ:PB"><data key="type">IntegrationMethod</data><data key="label">Potential-based shaping</data><data key="props">{"code": "PB", "definedBy": "this survey (Table II)"}</data></node>
<node id="integ:EG"><data key="type">IntegrationMethod</data><data key="label">Experience guidance (replay priority)</data><data key="props">{"code": "EG", "definedBy": "this survey (Table II)"}</data></node>
<node id="integ:TP"><data key="type">IntegrationMethod</data><data key="label">Task proposal</data><data key="props">{"code": "Task proposal", "definedBy": "this survey (Table II)"}</data></node>
<node id="modeling:MF"><data key="type">FeedbackModeling</data><data key="label">Model-free (feedback used directly)</data><data key="props">{"code": "MF", "note": "Survey sense: MF/MB qualify how a shaping method uses feedback, not whether the RL learner is model-based."}</data></node>
<node id="modeling:MB"><data key="type">FeedbackModeling</data><data key="label">Model-based (model of the teacher's feedback learned first)</data><data key="props">{"code": "MB", "note": "Survey sense: MF/MB qualify how a shaping method uses feedback, not whether the RL learner is model-based."}</data></node>
<node id="env:used"><data key="type">EnvRewardUse</data><data key="label">Environment reward used</data><data key="props">{}</data></node>
<node id="env:notused"><data key="type">EnvRewardUse</data><data key="label">Environment reward not used</data><data key="props">{}</data></node>
<node id="env:nr"><data key="type">EnvRewardUse</data><data key="label">Not reported</data><data key="props">{}</data></node>
<node id="env:na"><data key="type">EnvRewardUse</data><data key="label">Not applicable</data><data key="props">{}</data></node>
<node id="regime:online"><data key="type">FeedbackRegime</data><data key="label">Online: judges the learner's own behavior during training</data><data key="props">{}</data></node>
<node id="regime:offline"><data key="type">FeedbackRegime</data><data key="label">Offline: labels data collected before training</data><data key="props">{}</data></node>
<node id="regime:none"><data key="type">FeedbackRegime</data><data key="label">No behavior judged (advice or goals from the state or task)</data><data key="props">{}</data></node>
<node id="input:image"><data key="type">FMInput</data><data key="label">Image</data><data key="props">{}</data></node>
<node id="input:clip"><data key="type">FMInput</data><data key="label">Video clip</data><data key="props">{}</data></node>
<node id="input:text"><data key="type">FMInput</data><data key="label">Text (caption, state or episode text)</data><data key="props">{}</data></node>
<node id="excl:reward-code"><data key="type">ExclusionCategory</data><data key="label">Excluded: reward-code generation</data><data key="props">{"reason": "The LLM writes a reward program once or between training runs; it never judges behavior as it occurs."}</data></node>
<node id="excl:fm-policy"><data key="type">ExclusionCategory</data><data key="label">Excluded: foundation model as the policy</data><data key="props">{"reason": "The foundation model is itself the policy, so there is no separate learner to receive feedback."}</data></node>
<node id="form:binary"><data key="type">FeedbackForm</data><data key="label">Binary</data><data key="props">{}</data></node>
<node id="form:ternary"><data key="type">FeedbackForm</data><data key="label">Ternary</data><data key="props">{}</data></node>
<node id="form:nclass"><data key="type">FeedbackForm</data><data key="label">n-class (ordered labels)</data><data key="props">{}</data></node>
<node id="form:scalar"><data key="type">FeedbackForm</data><data key="label">Scalar (graded)</data><data key="props">{}</data></node>
<node id="form:pairwise"><data key="type">FeedbackForm</data><data key="label">Pairwise</data><data key="props">{}</data></node>
<node id="form:similarity"><data key="type">FeedbackForm</data><data key="label">Similarity (embedding cosine)</data><data key="props">{}</data></node>
<node id="form:action-label"><data key="type">FeedbackForm</data><data key="label">Action label</data><data key="props">{}</data></node>
<node id="form:correction"><data key="type">FeedbackForm</data><data key="label">Correction</data><data key="props">{}</data></node>
<node id="form:target-position"><data key="type">FeedbackForm</data><data key="label">Target position</data><data key="props">{}</data></node>
<node id="form:rule"><data key="type">FeedbackForm</data><data key="label">Rule</data><data key="props">{}</data></node>
<node id="form:target"><data key="type">FeedbackForm</data><data key="label">Target (object or region)</data><data key="props">{}</data></node>
<node id="form:free-form"><data key="type">FeedbackForm</data><data key="label">Free-form language</data><data key="props">{}</data></node>
