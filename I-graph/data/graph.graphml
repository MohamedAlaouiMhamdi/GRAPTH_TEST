<node id="experiment:P055-1"><data key="type">Experiment</data><data key="label">MINT-RL · Physical teaching; simulation evaluation</data><data key="props">{"workId": "work:koert_multi-channel_2020", "evidenceId": "P055-1", "sourceId": "P055", "sourceUrl": "https://doi.org/10.3389/frobt.2020.00097", "locator": "3.6; 4.1.2; 4.2.2, Figs 6, 8, 10, 11", "reviewedAt": "2026-11-24", "reviewStatus": "2026-11-24 targeted local primary-text method/initialization check; detailed outcomes/protocol retained from 2026-11-23 primary audit.", "teacher": "human", "providers": ["human", "oracle"], "decision": "include", "scopeLabel": "New-policy RL", "setting": "Physical teaching; simulation evaluation", "settingGroup": "Physical teaching; evaluation limited", "task": "Cocktail preparation and weight-based object sorting", "taskFamily": "Household task sequencing", "platform": "Physical Kobo manipulator", "feedbackSource": "20 inexperienced human participants; separate synthetic-feedback ablations", "feedback": "Mode A: reject or suggest actions. Mode B: reject actions or rate completed actions.", "levels": ["Rating", "Action"], "channel": "Touchscreen GUI", "model": "", "algorithm": "Tabular Q-learning with a learned advice table and shared action selection", "objective": "Sequential task Q-learning plus a learned advice table.", "policyInitialization": "Q table and advice table are initialized to zero in the method; pretrained recognition modules decode advice. The robot learns high-level task sequencing over primitives.", "integration": "Task rewards update Q-values; human feedback updates advice; confidence balances the two policies.", "comparison": "Unaided RL; Mode A versus Mode B", "result": "Both modes speed policy convergence relative to unaided RL. The learning-speed difference between modes is not significant. Mode A has shorter interaction time.", "finding": "Physical teaching; repeated checkpoint evaluation is in simulation.", "evaluation": "Kitchen: 10 episodes per mode; sorting: 20 episodes per mode. Each policy checkpoint evaluated with 50 simulated rollouts per person.", "participants": "20", "extraSupport": "", "limitations": "Teaching and learning occur on hardware, but the reported reward curves use simulated evaluation. Subgoal-reward ablations use synthetic feedback. Some participants reject correct robot suggestions.", "scopeReason": "Retain task-policy learning with feedback; no imported pretrained action policy is established. The learner/objective and evidence setting are stated separately.", "uncertainties": []}</data></node>
