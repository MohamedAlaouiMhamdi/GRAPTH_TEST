<node id="experiment:P041-1"><data key="type">Experiment</data><data key="label">Multimodal advice · Physical teaching; evaluation unclear</data><data key="props">{"workId": "work:trick_interactive_2022", "evidenceId": "P041-1", "sourceId": "P041", "sourceUrl": "https://doi.org/10.1109/LRA.2022.3182100", "locator": "III, Algorithm 1; IV-C, Figs 4-6", "reviewedAt": "2026-11-24", "reviewStatus": "2026-11-24 targeted local primary-text method/initialization check; detailed outcomes/protocol retained from 2026-11-23 primary audit.", "teacher": "human", "providers": ["human"], "decision": "include", "scopeLabel": "New-policy RL", "setting": "Physical teaching; evaluation unclear", "settingGroup": "Physical teaching; evaluation limited", "task": "Prepare pancake batter: fetch flour/milk and pour into bowl", "taskFamily": "Household task sequencing", "platform": "Physical 7-DoF arm", "feedbackSource": "10 live human participants", "feedback": "Discrete action advice", "levels": ["Action"], "channel": "Speech plus gestures/depth camera", "model": "", "algorithm": "Tabular Q-learning; Bayesian independent opinion pool", "objective": "Sequential task Q-learning plus Bayesian advice fusion.", "policyInitialization": "Algorithm 1 initializes Q table/visits and uses tabular Q-learning with gamma=0.98. Speech/gesture recognizers are trained separately; the action-sequencing policy is not imported.", "integration": "Advice selects executed action; task rewards update Q after transitions", "comparison": "Confidence-based C-IRL; unaided Q-learning", "result": "Bayesian fusion learns faster than unaided RL for all 10 participants; similar to C-IRL for four and better for six.", "finding": "Ten-user teaching study; aggregate evaluation setting remains unclear.", "evaluation": "Two blocks of 20 advising episodes per person; 50 learning runs and 100 policy evaluations per episode reported.", "participants": "10", "extraSupport": "", "limitations": "Physical teaching is demonstrated. It 