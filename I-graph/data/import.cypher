CREATE (:Node:Experiment {`id`: 'experiment:P085-1', `label`: 'T2-VLM · Simulation', `workId`: 'work:zhao_training-free_2025', `evidenceId`: 'P085-1', `sourceId`: 'P085', `sourceUrl`: 'https://arxiv.org/html/2507.04789v1', `locator`: 'Section 4.1 and Figure 5; Appendix A; Appendix C.1–C.2.', `reviewedAt`: '2026-11-24', `reviewStatus`: 'Fresh targeted primary method/initialization check on 24 November; existing results and evaluation audit reused', `teacher`: 'fm', `providers`: ['fm'], `decision`: 'include', `scopeLabel`: 'New-policy RL', `setting`: 'Simulation', `settingGroup`: 'Simulation', `task`: 'Place same-colour objects, stack a tower, arrange blocks in a line, and clean up a desk; additional recovery tests.', `taskFamily`: 'Object manipulation / skill selection', `platform`: 'Simulated arms in CLIPort and CALVIN', `feedbackSource`: 'Qwen2-VL as the default evaluator; SAM2 tracking and Bayesian particle filters maintain progress estimates.', `feedback`: 'Initial binary subgoal-completion judgments converted through tracking into continuous progress-difference rewards.', `levels`: ['Rating'], `channel`: '', `model`: 'Qwen2-VL as the default evaluator; SAM2 tracking and Bayesian particle filters maintain progress estimates.', `algorithm`: 'SAC with an object-centric transformer architecture; temperature set to zero in the appendix.', `objective`: 'The VLM decomposes the task and initializes subgoal statuses before an episode. Tracking updates progress during execution; progress differences reward SAC updates. The VLM need not be queried at every action for its judgments to influence policy training.', `policyInitialization`: 'Appendix A jointly updates CNN/self-attention/policy/value networks under SAC. Appendix C.2 defines object/skill-combination actions implemented by primitive controllers, with no loaded task actor described.', `integration`: 'The VLM decomposes the task and initializes subgoal statuses before an episode. Tracking updates progress during execution; progress differences reward SAC updates. The VLM need not be queried at every action for its judgments to influence policy training.', `comparison`: 'Environment rewards, VLM-CaR and RL-VLM-F for learning; planning baselines for recovery.', `result`: 'Reported subgoal-completion curves are comparable to environment rewards and stronger than VLM-CaR and RL-VLM-F in the tested setup. Recovery experiments measure task success and number of high-level actions.', `finding`: 'Learns choices over supplied skills; hardware branch only tests rewards.', `evaluation`: 'Three seeds; 400 training episodes on CLIPort tasks and 2,000 on CALVIN; recovery evaluated over 20 trials.', `participants`: '', `extraSupport`: 'Task text and execution primitives. Simulator-provided object boxes are used by the policy; reward computation uses SAM2 rather than those privileged boxes.', `limitations`: 'Simulation only for policy learning. The learned action selects picking/placing objects or combinations of named skills and objects; do not describe this as necessarily learning low-level motor control. Subgoal-completion ratio is not identical to full-task success.', `scopeReason`: 'New SAC task-level object/skill selection learns from VLM-initialized tracked rewards. Count high-level task-policy learning, with existing primitives explicit; do not describe motor control learned from scratch.', `uncertainties`: ['Physical task names are not fully specified in the passages retained for this targeted review; do not invent them. No hardware policy update is evidenced in the inspected methods and experiments.']});
