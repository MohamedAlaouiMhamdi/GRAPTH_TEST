CREATE (:Node:Experiment {`id`: 'experiment:P090-1', `label`: 'VLM-RM · Simulation', `workId`: 'work:rocamonde_vision-language_2023', `evidenceId`: 'P090-1', `sourceId`: 'P090', `sourceUrl`: 'https://arxiv.org/html/2310.12921v2', `locator`: 'Section 4.3, Table 1, Figure 3; Appendix B; Appendix C.2.', `reviewedAt`: '2026-11-24', `reviewStatus`: 'Fresh targeted primary method/initialization check on 24 November; existing results and evaluation audit reused', `teacher`: 'fm', `providers`: ['fm'], `decision`: 'include', `scopeLabel`: 'New-policy RL', `setting`: 'Simulation', `settingGroup`: 'Simulation', `task`: 'Eight target poses: kneeling, lotus position, standing, arms raised, splits, hands on hips, standing on one leg, and arms crossed.', `taskFamily`: 'Humanoid posture control', `platform`: 'MuJoCo Humanoid-v4', `feedbackSource`: 'Frozen CLIP; largest model used for the principal humanoid experiments.', `feedback`: 'Scalar score derived from visual and textual embedding similarity.', `levels`: ['Rating'], `channel`: '', `model`: 'Frozen CLIP; largest model used for the principal humanoid experiments.', `algorithm`: 'SAC', `objective`: 'Rendered observations receive CLIP scores in periodic batches. Those scores replace the environment reward in replay and drive SAC actor and critic updates.', `policyInitialization`: 'Algorithm 1 initializes SAC and empty replay buffers; Appendix C.2 trains a two-layer MLP after 50,000 initial steps.', `integration`: 'Rendered observations receive CLIP scores in periodic batches. Those scores replace the environment reward in replay and drive SAC actor and critic updates.', `comparison`: 'Reward-model size, goal-baseline regularization, camera and texture modifications; no hardware comparison.', `result`: 'Five of eight poses reach 100% reported success; hands on hips reaches 64%; one-leg standing and arms crossed reach 0%.', `finding`: 'Five of eight poses reach reported 100%; best checkpoint across four seeds.', `evaluation`: 'Ten million simulator steps; highest-reward checkpoint selected across four seeds; 100 trajectories per task labelled by one rater. Episode success requires the target pose for about half the episode.', `participants`: '', `extraSupport`: 'Language goal; some experiments use a baseline prompt. Human ratings are used for evaluation, not policy-training rewards.', `limitations`: 'Single-rater, coarse pose evaluation and selected checkpoint; modified textures and camera help CLIP. No physical robot training or transfer. CartPole and MountainCar are separate control benchmarks, not counted as robot applications.', `scopeReason`: 'CLIP is a pretrained evaluator, while a new SAC task actor is trained to realize humanoid poses.', `uncertainties`: ['No independent replication. Main text and appendix phrase the 50%-of-steps success threshold slightly differently; do not treat the reported rate as precise physical pose reliability.']});
CREATE (:Node:Task {`id`: 'experiment-task:P090-1', `label`: 'Eight target poses: kneeling, lotus position, standing, arms raised, splits, hands on hips, standing on one leg, and arms crossed.', `experimentId`: 'P090-1', `taskFamily`: 'Humanoid posture control'});
CREATE (:Node:Experiment {`id`: 'experiment:P028-1', `label`: 'FuRL · Simulation', `workId`: 'work:fu_furl_2024', `evidenceId`: 'P028-1', `sourceId`: 'P028', `sourceUrl`: 'https://arxiv.org/html/2406.00645v2', `locator`: 'Sections 3.1–3.2 and Algorithm 1; Sections 5.2–5.4; Tables 1–2.', `reviewedAt`: '2026-11-24', `reviewStatus`: 'Fresh targeted primary method/initialization check on 24 November; existing results and evaluation audit reused', `teacher`: 'fm', `providers`: ['fm'], `decision`: 'include', `scopeLabel`: 'New-policy RL', `setting`: 'Simulation', `settingGroup`: 'Simulation', `task`: 'Ten reaching/manipulation tasks including pushing, drawers, door, windows, button pressing, peg insertion and pick-and-place.', `taskFamily`: 'Object manipulation', `platform`: 'Simulated Sawyer arm in Meta-World MT10', `feedbackSource`: 'Frozen LIV backbone with learned image and language projection heads; CLIP is also investigated.', `feedback`: 'Scalar similarity-derived reward.', `levels`: ['Rating'], `channel`: '', `model`: 'Frozen LIV backbone with learned image and language projection heads; CLIP is also investigated.', `algorithm`: 'SAC for state observations; DrQ for the pixel-input experiment.', `objective`: 'The main agent learns from sparse environment success reward plus weighted VLM reward. An auxiliary SAC policy uses only environment reward; relay exploration shares experience between policies. Successful and unsuccessful trajectories align reward projection heads.', `policyInitialization`: 'Algorithm 1 initializes image/text projections, VLM agent and auxiliary SAC agent. Section 3.2 trains both with a shared replay buffer.', `integration`: 'The main agent learns from sparse environment success reward plus weighted VLM reward. An auxiliary SAC policy uses only environment reward; relay exploration shares experience between policies. Successful and unsuccessful trajectories align reward projection heads.', `comparison`: 'Sparse SAC, unadapted VLM rewards, LIV, random projection, relay exploration, and reward-alignment ablations.', `result`: 'Fixed-goal MT10 mean final success is reported as 76% for FuRL versus 37% for sparse-reward SAC. Both FuRL and baselines fail on peg insertion and pick-and-place in this setup. The pixel window-opening experiment learns faster than DrQ.', `finding`: '76% vs 37% mean in one setup; two tasks fail and task rewards remain.', `evaluation`: 'One million environment steps; five random seeds; final success-rate evaluation for fixed and random goals.', `participants`: '', `extraSupport`: 'Sparse ground-truth success reward, task text, and a goal image in the main variant; a no-goal-image variant is evaluated.', `limitations`: 'Simulation only; VLM feedback complements a task-success oracle rather than removing all engineered task rewards. Improvements combine reward alignment and relay exploration. The 76% figure is a mean across ten fixed-goal benchmark tasks, not a real-robot success rate.', `scopeReason`: 'Both task actors are initialized for learning in the algorithm. Frozen LIV features and trained reward projections are not a pretrained action policy.', `uncertainties`: ['No physical experiment or sim-to-real transfer reported.']});
CREATE (:Node:Task {`id`: 'experiment-task:P028-1', `label`: 'Ten reaching/manipulation tasks including pushing, drawers, door, windows, button pressing, peg insertion and pick-and-place.', `experimentId`: 'P028-1', `taskFamily`: 'Object manipulation'});
CREATE (:Node:Experiment {`id`: 'experiment:P052-1', `label`: 'MARVL · Simulation', `workId`: 'work:zhou_marvl_2026', `evidenceId`: 'P052-1', `sourceId`: 'P052', `sourceUrl`: 'https://arxiv.org/abs/2602.15872', `locator`: 'Equation 1; Sections 3 and 4; Figure 6; Appendix B.1–B.4, C.1–C.3; hyperparameter tables.', `reviewedAt`: '2026-11-24', `reviewStatus`: 'Fresh targeted primary method/initialization check on 24 November; existing results and evaluation audit reused', `teacher`: 'fm', `providers`: ['fm'], `decision`: 'include', `scopeLabel`: 'New-policy RL', `setting`: 'Simulation', `settingGroup`: 'Simulation', `task`: 'Eight Meta-World manipulation tasks, including pushing, buttons, doors, drawers and windows; additional Panda-Gym manipulation generalization.', `taskFamily`: 'Object manipulation', `platform`: 'Sawyer arm in Meta-World and Franka Panda in Panda-Gym', `feedbackSource`: 'CLIP ViT-B/32 adapted for scene/view decomposition; Qwen-3-Flash and Qwen-ImageEditPlus supply subgoals and target images in the automated variant.', `feedback`: 'Scalar similarity-derived, stage-dependent reward with confidence gating.', `levels`: ['Rating'], `channel`: '', `model`: 'CLIP ViT-B/32 adapted for scene/view decomposition; Qwen-3-Flash and Qwen-ImageEditPlus supply subgoals and target images in the automated variant.', `algorithm`: 'SAC; TD3 robustness experiment.', `objective`: 'The reward combines sparse task reward with a weighted visual-language shaping term. Adapted representations, stage target descriptions/images and task-direction projection shape progress; the resulting reward drives the RL actor and critic.', `policyInitialization`: 'Section 4 uses common state-based SAC; appendix hyperparameter table specifies 10,000 initial random-exploration steps. Pretrained/adapted CLIP supplies reward features.', `integration`: 'The reward combines sparse task reward with a weighted visual-language shaping term. Adapted representations, stage target descriptions/images and task-direction projection shape progress; the resulting reward drives the RL actor and critic.', `comparison`: 'Sparse SAC, LIV, FuRL, Relay, dense-reward oracle and component ablations.', `result`: 'Learning curves report stronger success and convergence than VLM-reward baselines across eight tasks; some tasks match or exceed the dense-reward oracle comparator. Robustness is tested with a different RL algorithm, cameras and Panda-Gym.', `finding`: 'Stronger tested learning curves; task rewards and reward adaptation remain.', `evaluation`: 'Main Meta-World curves average five random seeds; reported training budget is one million environment steps per task.', `participants`: '', `extraSupport`: 'Sparse task reward; target stages/images specified manually in controlled experiments or generated by models; 500 simulator images with camera perturbations and known scene/view identities for representation adaptation.', `limitations`: 'All policy training and evaluation are simulated. Panda-Gym generalization is simulation-to-simulation, not sim-to-real. The abstract phrase about visual rewards must not erase the sparse task-reward term in the method setup. Generated goal quality and privileged simulator data remain qualifications.', `scopeReason`: 'Task-specific SAC/TD3 learns with adapted CLIP rewards. Initial random exploration and new actor/critic training are described; CLIP pretraining concerns feedback representation.', `uncertainties`: ['The local paper does not independently establish the exact runtime frequency of encoder calls. Its current-state reward formulation is sufficient to establish reward-driven RL; do not overclaim implementation timing.']});
CREATE (:Node:Task {`id`: 'experiment-task:P052-1', `label`: 'Eight Meta-World manipulation tasks, including pushing, buttons, doors, drawers and windows; additional Panda-Gym manipulation generalization.', `experimentId`: 'P052-1', `taskFamily`: 'Object manipulation'});
CREATE (:Node:Experiment {`id`: 'experiment:P008-1', `label`: 'Lafite-RL · Simulation', `workId`: 'work:chu_accelerating_2023', `evidenceId`: 'P008-1', `sourceId`: 'P008', `sourceUrl`: 'https://arxiv.org/html/2311.02379v1', `locator`: 'Section 3, equations 1–2; Section 4, Figure 4 and Table 2; Section 5.', `reviewedAt`: '2026-11-24', `reviewStatus`: 'Fresh targeted primary method/initialization check on 24 November; existing results and evaluation audit reused', `teacher`: 'fm', `providers`: ['fm'], `decision`: 'include', `scopeLabel`: 'New-policy RL', `setting`: 'Simulation', `settingGroup`: 'Simulation', `task`: 'Push buttons; take an umbrella out of its stand.', `taskFamily`: 'Object manipulation', `platform`: 'Franka Panda in RLBench', `feedbackSource`: 'Frozen Vicuna-13B v1.5', `feedback`: 'Binary good/bad motion evaluation, parsed as +1 or −1; zero is a parsing fallback.', `levels`: ['Rating'], `channel`: '', `model`: 'Frozen Vicuna-13B v1.5', `algorithm`: 'DreamerV3', `objective`: 'Every four environment timesteps, text descriptions of movement and scene geometry are evaluated by Vicuna. The parsed feedback reward is added to the sparse environment reward and supplied to DreamerV3 training.', `policyInitialization`: 'Section 4 specifies middle-size DreamerV3 with default settings, 200,000 task-training steps and three seeds. No external actor checkpoint or imitation initialization is stated.', `integration`: 'Every four environment timesteps, text descriptions of movement and scene geometry are evaluated by Vicuna. The parsed feedback reward is added to the sparse environment reward and supplied to DreamerV3 training.', `comparison`: 'Same DreamerV3 setup without the LLM feedback reward.', `result`: 'Reported final success: button pushing 70.3% versus 41.6%; umbrella removal 68.7% versus 26.1% for DreamerV3 without language feedback.', `finding`: 'Improves two-task success versus base learner; three seeds.', `evaluation`: 'Two tasks; 200,000 training steps; three random seeds; 100 evaluation episodes after learning.', `participants`: '', `extraSupport`: 'Environment success reward, scaled to 100; manually designed task prompts; privileged scene coordinates, gripper state and distance API for the language evaluator.', `limitations`: 'Simulation only, two tasks, and access to geometric state information. The result supports added LLM feedback in this setup; it does not establish vision-only reward generation or physical-robot reliability.', `scopeReason`: 'Vicuna evaluates movements and augments rewards for task-specific DreamerV3 robot learning; no loaded pretrained robot actor is described.', `uncertainties`: ['The paper does not claim physical-robot training or sim-to-real transfer.']});
CREATE (:Node:Task {`id`: 'experiment-task:P008-1', `label`: 'Push buttons; take an umbrella out of its stand.', `experimentId`: 'P008-1', `taskFamily`: 'Object manipulation'});
CREATE (:Node:Experiment {`id`: 'experiment:P013-1', `label`: 'AutoSkill · Simulation', `workId`: 'work:lin_autoskill_2025', `evidenceId`: 'P013-1', `sourceId`: 'P013', `sourceUrl`: 'https://ieeexplore.ieee.org/document/10924760', `locator`: 'Section III.C, equations 2–6, Algorithm 1; Section IV.A–IV.B, Figure 5.', `reviewedAt`: '2026-11-24', `reviewStatus`: 'Fresh targeted primary method/initialization check on 24 November; existing results and evaluation audit reused', `teacher`: 'fm', `providers`: ['fm'], `decision`: 'include', `scopeLabel`: 'New-policy RL', `setting`: 'Simulation', `settingGroup`: 'Simulation', `task`: 'Two long-horizon kitchen tasks, Hammer Cleanup, and Stack Three; acquisition of missing skills for completing these tasks.', `taskFamily`: 'Object manipulation / skill composition', `platform`: 'Franka Panda in FrankaKitchen and robosuite/MuJoCo', `feedbackSource`: 'Gemini Pro Vision for binary success; ResNet-50/DistilBERT event-score model pretrained on Ego4D and fine-tuned for tabletop manipulation. Gemini Pro separately proposes skill chains.', `feedback`: 'Binary success plus scalar event/progress score; the scalar is an MLP score, not cosine similarity.', `levels`: ['Rating'], `channel`: '', `model`: 'Gemini Pro Vision for binary success; ResNet-50/DistilBERT event-score model pretrained on Ego4D and fine-tuned for tabletop manipulation. Gemini Pro separately proposes skill chains.', `algorithm`: 'Modified SAC for modular primitive-parameter policies.', `objective`: 'After each primitive execution, weighted event and success scores become rewards in replay. Modified SAC optimizes the parameter policies for newly proposed skills and their critics. The LLM planner proposes skills and sketches but the reward module supplies the learning signal.', `policyInitialization`: 'III.A/III.C.3 and Algorithm 1 learn missing primitive-parameter skill policies from scratch using SAC; IV.A.3 specifies separate MLP actors, while base skills and control primitives are available.', `integration`: 'After each primitive execution, weighted event and success scores become rewards in replay. Modified SAC optimizes the parameter policies for newly proposed skills and their critics. The LLM planner proposes skills and sketches but the reward module supplies the learning signal.', `comparison`: 'Sketch RL, CeSD, FIST-ft, and modified SayCan+CLIP, plus reward-component ablations.', `result`: 'Reported higher task success and oracle-normalized returns than the compared methods in four simulated tasks.', `finding`: 'Learns missing skill parameters; supplied primitives and skills remain.', `evaluation`: 'Learning curves across five seeds with standard deviations.', `participants`: '', `extraSupport`: 'Existing base skills and primitive controllers; low-dimensional task and proprioceptive states; pretrained video-language data and tabletop adaptation for the event model. No added ground-truth task reward in the audited missing-skill learning stage.', `limitations`: 'A supplied skill library, predefined primitive structure and a single missing skill constrain the setup. It is not end-to-end acquisition of every low-level behaviour from an unstructured task instruction.', `scopeReason`: 'New primitive-parameter skill policies are trained with SAC when a needed skill is absent. Reused base skills and primitive controllers are explicitly retained; this is skill acquisition, not refinement of a pretrained whole-task actor.', `uncertainties`: ['The IEEE webpage required JavaScript, so substantive verification used the supplied final journal PDF. Exact primitive-controller transfer implementation is less fully specified than the simulation RL method; do not infer additional on-hardware adaptation.']});
CREATE (:Node:Task {`id`: 'experiment-task:P013-1', `label`: 'Two long-horizon kitchen tasks, Hammer Cleanup, and Stack Three; acquisition of missing skills for completing these tasks.', `experimentId`: 'P013-1', `taskFamily`: 'Object manipulation / skill composition'});
CREATE (:Node:Experiment {`id`: 'experiment:P013-2', `label`: 'AutoSkill · Sim-to-real transfer', `workId`: 'work:lin_autoskill_2025', `evidenceId`: 'P013-2', `sourceId`: 'P013', `sourceUrl`: 'https://ieeexplore.ieee.org/document/10924760', `locator`: 'Section IV.C and Figure 10; Section V conclusion, PDF pages 9–10.', `reviewedAt`: '2026-11-24', `reviewStatus`: 'Fresh targeted primary method/initialization check on 24 November; existing results and evaluation audit reused', `teacher`: 'fm', `providers`: ['fm'], `decision`: 'include', `scopeLabel`: 'New-policy RL', `setting`: 'Sim-to-real transfer', `settingGroup`: 'Sim-to-real transfer', `task`: 'Hammer Cleanup and Stack Three', `taskFamily`: 'Object manipulation / skill composition', `platform`: 'Physical UR3', `feedbackSource`: 'Same AutoSkill reward system used during preceding simulated skill acquisition.', `feedback`: 'Binary success plus scalar event/progress reward during training in simulation.', `levels`: ['Rating'], `channel`: '', `model`: 'Same AutoSkill reward system used during preceding simulated skill acquisition.', `algorithm`: 'Modified SAC during the simulation stage.', `objective`: 'The policies are trained in simulation using model-generated rewards, then transferred for physical execution. The paper does not demonstrate reward-driven policy updates on the UR3.', `policyInitialization`: 'IV.C transfers the simulation-trained primitive-parameter policies to UR3; conclusion leaves online hardware adaptation to future work.', `integration`: 'The policies are trained in simulation using model-generated rewards, then transferred for physical execution. The paper does not demonstrate reward-driven policy updates on the UR3.', `comparison`: 'No controlled hardware ablation isolating foundation-model reward is reported in this section.', `result`: '100% Hammer Cleanup success and 60% Stack Three success.', `finding`: '10/10 and 6/10 transfer trials; supplied controllers and skill library.', `evaluation`: 'Ten physical trials per task.', `participants`: '', `extraSupport`: 'Access to a simulation of the target task and transfer-compatible primitive/control structure.', `limitations`: 'Small controlled hardware evaluation. The conclusion explicitly identifies online adaptation to real-world tasks as future work. Do not call the UR3 experiment real-robot RL training.', `scopeReason`: 'The newly learned simulated skill policies are executed on UR3. Transfer is eligible evidence for the first category; no hardware fine-tuning is claimed.', `uncertainties`: ['The IEEE webpage required JavaScript, so substantive verification used the supplied final journal PDF. Exact primitive-controller transfer implementation is less fully specified than the simulation RL method; do not infer additional on-hardware adaptation.']});
