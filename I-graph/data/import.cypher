CREATE (:Node:TableRow {`id`: 'row:F16', `label`: 'Table II, row F16', `table`: 'II', `block`: 'Action advice', `order`: 16, `nWorks`: 1, `form`: 'Action label', `integration`: 'Override → Decision Biasing', `envReward`: 'Present', `tasks`: 'FrozenLake (sim)', `model`: 'Open VLM, frozen (Gemma-3-4B)', `input`: 'Image + task text', `timing`: 'None; on demand (entropy)', `level`: 'Action'});
CREATE (:Node:Task {`id`: 'task:frozenlake', `label`: 'FrozenLake', `kind`: 'named benchmark', `settings`: ['sim']});
CREATE (:Node:TableRow {`id`: 'row:F17', `label`: 'Table II, row F17', `table`: 'II', `block`: 'Goal guidance', `order`: 17, `nWorks`: 1, `form`: 'Goal list', `integration`: 'Similarity → RS (MF)', `envReward`: 'Absent', `tasks`: 'Crafter, Housekeep (sim)', `model`: 'API LLM, frozen (Codex; text-davinci-002 on Housekeep) + SBERT', `input`: 'State caption (template or captioner)', `timing`: 'Own; every step, cached', `level`: 'Goal'});
CREATE (:Node:Task {`id`: 'task:housekeep', `label`: 'Housekeep', `kind`: 'named benchmark', `settings`: ['sim']});
CREATE (:Node:TableRow {`id`: 'row:F18', `label`: 'Table II, row F18', `table`: 'II', `block`: 'Goal guidance', `order`: 18, `nWorks`: 1, `form`: 'Subgoal list (targets)', `integration`: 'Subgoal reward → RS (MF), goal-conditioned', `envReward`: 'Present', `tasks`: 'MiniGrid (sim)', `model`: 'Open LLMs, frozen (Llama-3-70B)', `input`: 'Text grid of s₀', `timing`: 'None; per episode or once', `level`: 'Goal'});
CREATE (:Node:TableRow {`id`: 'row:F19', `label`: 'Table II, row F19', `table`: 'II', `block`: 'Goal guidance', `order`: 19, `nWorks`: 1, `form`: 'Skill chain + sketch', `integration`: '→ Task proposal', `envReward`: 'n/a', `tasks`: 'FrankaKitchen, robosuite (sim); UR3: sim-to-real', `model`: 'API LLM, frozen (Gemini-Pro)', `input`: 'Task text + skill library', `timing`: 'None; once per task, N-vote', `level`: 'Goal (skill)', `module`: 'planner'});
CREATE (:Node:ResearchLine {`id`: 'line:tamer', `label`: 'TAMER line (Knox, Stone and co-authors)', `basis`: 'survey text names "the TAMER line"; project independence rule'});
CREATE (:Node:ResearchLine {`id`: 'line:facial', `label`: 'Facial-feedback line (Li, Lin, Wang and co-authors)', `basis`: 'survey text names "one facial-feedback line"; project independence rule'});
CREATE (:Node:ResearchLine {`id`: 'line:simuser', `label`: 'Simulated-user and persistent-advice line (Bignold, Nguyen, Cruz, Millán)', `basis`: 'survey text names "the persistent-advice line" and "two studies from one group"; project independence rule'});
CREATE (:Node:ResearchLine {`id`: 'line:thomaz', `label`: 'Thomaz and Breazeal (Sophie\'s Kitchen)', `basis`: 'survey text names the authors'});
CREATE (:Node:ResearchLine {`id`: 'line:klissarov', `label`: 'Klissarov et al. (Motif and follow-up)', `basis`: 'same first author in the survey text; project brief: the two papers share authors'});
CREATE (:Node:Challenge {`id`: 'challenge:human-1', `label`: 'Inconsistent Feedback and the Missing User Model', `teacher`: 'human', `order`: 1, `section`: 'sec:ch-human', `statement`: 'Human feedback is inconsistent: teachers make errors, lean towards one valence and follow different “training strategies”, and inconsistent feedback “can cause considerable delay in the learning process”.', `openQuestion`: 'Whether a learner can estimate its teacher\'s reliability, bias and strategy during the interaction, separating teacher error from recognition error, remains untested.', `text`: 'Human feedback is inconsistent: teachers make errors, lean towards one valence and follow different “training strategies”, and inconsistent feedback “can cause considerable delay in the learning process”. Modest error rates are enough to cancel what the teacher contributes: with a scripted oracle, Advise became equivalent to learning without feedback at an estimated consistency of 0.55, and TICS improved convergence only while the probability of an erroneous instruction stayed below 0.3. Teachers also differ and change. Valence is biased, but not always in the same direction, from 69.8% positive rewards in Sophie\'s Kitchen to 75% to 82% negative feedback with plain TAMER in a grid world; depending on the trainer, silence means punishment or approval, and participants reported switching strategy during training. Learners nevertheless fix these quantities in advance: Loftin et al. set the trainer error probability at 0.2 or 0.05, while the rates later estimated from their participants were 0.085 for volunteers and 0.034 for crowd workers, and Christiano et al. assumed a fixed 10% chance of a uniformly random answer. As Arzate Cruz and Igarashi note, “a formal model of users” for interactive RL “has not been proposed”. Whether a learner can estimate its teacher\'s reliability, bias and strategy during the interaction, separating teacher error from recognition error, remains untested.', `version`: 'Section IX v4'});
CREATE (:Node:Challenge {`id`: 'challenge:human-2', `label`: 'Cost of Human Feedback and User Fatigue', `teacher`: 'human', `order`: 2, `section`: 'sec:ch-human', `statement`: 'Human feedback is expensive and it fades.', `openQuestion`: 'Whether any combination of label format, query rule and generalization brings a robot task within one non-expert\'s session remains untested.', `text`: 'Human feedback is expensive and it fades. Lee et al. describe human-in-the-loop RL as “challenging to scale since human feedback is very expensive”: Christiano et al. used 700 human queries on MuJoCo and 5,500 on Atari, whereas Hejna and Sadigh\'s expert answered 36 to 100 queries in about 22 to 60 minutes, and random query selection is sometimes competitive with active selection. Teachers “give copious feedback early in training but very sparsely thereafter”: most of Knox and Stone\'s 9 TAMER trainers had stopped giving feedback by the fifth game, and “user fatigue” is among the open challenges named by Arzate Cruz and Igarashi. Each label also says little. A preference carries at most one bit, in Celemin et al.\'s corrective framework a correction gives only a sign, with a magnitude the user sets before learning, and feedback usually applies only to the states where it was given. Methods therefore stay small: Yu et al. ran human experiments only on 5\\times5 Grid Pac-Man, because a grid run already lasts about 1.5 hours. Whether any combination of label format, query rule and generalization brings a robot task within one non-expert\'s session remains untested.', `version`: 'Section IX v4'});
CREATE (:Node:Challenge {`id`: 'challenge:human-3', `label`: 'Interpretation of Human Feedback', `teacher`: 'human', `order`: 3, `section`: 'sec:ch-human', `statement`: 'The same human signal admits “different interpretations”: as reward, as a label on the policy, or as advantage relative to the learner\'s current behavior.', `openQuestion`: 'Whether a learner can infer, for each teacher and during the interaction, which reading a signal carries remains untested.', `text`: 'The same human signal admits “different interpretations”: as reward, as a label on the policy, or as advantage relative to the learner\'s current behavior. Feedback is “policy-dependent”: with a scripted virtual dog, feedback on one state–action pair changed sign with the perceived trend, with a mean of 9.8 when the dog improved against −18.3 when it held steady. People also use the reward channel “for future-directed guidance”: in Sophie\'s Kitchen, 15 of 18 participants rewarded objects not yet used. Each fixed reading has its own failure. Read as discounted MDP reward, human evaluations create “positive circuits”, which 86.6% of trainers created in an episodic grid world, while the myopic alternative encodes a policy rather than a goal. Reactions read from faces or voices fare no better as reward: in EMPATHIC only the reward class of an event was predicted better than chance, while models of advantage overfit, and vocal energy correlated with advantage for only 3 of 14 teachers. Whether a learner can infer, for each teacher and during the interaction, which reading a signal carries remains untested.', `version`: 'Section IX v4'});
CREATE (:Node:Challenge {`id`: 'challenge:human-4', `label`: 'Delayed Feedback, Credit Assignment and Recognition Errors', `teacher`: 'human', `order`: 4, `section`: 'sec:ch-human', `statement`: 'Before a human signal can teach, it must be recognized and attached to the behavior it judges.', `openQuestion`: 'Whether a learner can tell, online and at task speed, which event a signal refers to remains untested.', `text`: 'Before a human signal can teach, it must be recognized and attached to the behavior it judges. Human reward arrives late, so learners need “credit assignment to create labels from delayed reward signals”, yet the delay is handled with constants that do not transfer: COACH used a delay of 6 steps (0.198 s) on a TurtleBot, Deep TAMER fitted a Uniform[0.2, 4] s window on Bowling, and on the robot Nexi action lag credited reward to the wrong action until turns were lengthened to 2.5 s. Signals read from faces, voices or EEG add recognition errors, often of the wrong sign: agents trained on predicted facial feedback at 62% to 73% accuracy were only a little better than random feedback, and on the robot Haru “the recognition error of human feedback” set learning back for a time. Words and gestures must be grounded, so most systems reduce them to fixed vocabularies, such as 33 fixed sentences or two predefined gestures. Unprompted reactions are the hardest case: in EMPATHIC they ran from 2.8 s before to 3.6 s after an event, yet most studies elicit posed signals. Whether a learner can tell, online and at task speed, which event a signal refers to remains untested.', `version`: 'Section IX v4'});
CREATE (:Node:Challenge {`id`: 'challenge:human-5', `label`: 'Lack of Evaluation with Real Users', `teacher`: 'human', `order`: 5, `section`: 'sec:ch-human', `statement`: 'Much of the field\'s evidence comes from teachers that are not people.', `openQuestion`: 'Whether methods rank the same with simulated teachers as with non-expert people teaching a physical robot remains untested.', `text`: 'Much of the field\'s evidence comes from teachers that are not people. Simulated users are used because “human trials are expensive, time-consuming, suffer from issues with repeatability”, yet “simulated oracles do not behave like humans”. A scripted oracle supplied all feedback for Advise and most of PEBBLE\'s results, and when people do teach, they are often the authors. Samples are small: Bignold et al. compared 10 participants per condition, and 4 of Knierim et al.\'s 14 sessions survived intact. Benchmarks are altered before use and the teacher\'s experience is seldom measured, so results can rarely be compared. The gap is widest on robots: Knox et al. described their Nexi work as only the second project to train a robot exclusively from human reward, and closed-loop studies with several people on hardware, such as Koert et al.\'s 20 inexperienced users on a real arm, are exceptions. Whether methods rank the same with simulated teachers as with non-expert people teaching a physical robot remains untested.', `version`: 'Section IX v4'});
CREATE (:Node:Challenge {`id`: 'challenge:fm-1', `label`: 'Noisy Feedback from Error-Prone, Hallucinating Models', `teacher`: 'fm', `order`: 1, `section`: 'sec:ch-fm', `statement`: 'Foundation models are “error-prone” teachers: “VLMs are known to hallucinate”, and the models are “prone to hallucinations” or “omit critical details”.', `openQuestion`: 'Whether a learner can estimate its feedback model\'s false-positive and false-negative rates per state during training, without ground truth, remains untested.', `text`: 'Foundation models are “error-prone” teachers: “VLMs are known to hallucinate”, and the models are “prone to hallucinations” or “omit critical details”. Their errors are both random and systematic. Gemini-1.5-Pro labeled the same segment differently on repeated queries even at temperature 0, and label smoothing did not help on Drawer Open, partly because the share of corrupted labels is hard to estimate; Llama 3.1 8B favored the option shown first, scoring 0.76 on ALFWorld with the correct option first against 0.69 with it second. Omissions do the most damage: Codex never suggested a wood pickaxe in Crafter, so ELLM\'s agent never acquired it, and on Housekeep text-davinci-002 recognized correct placements with as little as 50% accuracy, the low-accuracy tasks pretraining worse. Learners absorb these errors with fixed devices, such as repeated queries, Elo ratings and robust losses, and only Words as Beacons fits an error model of its LLM\'s subgoals, against an oracle. Whether a learner can estimate its feedback model\'s false-positive and false-negative rates per state during training, without ground truth, remains untested.', `version`: 'Section IX v4'});
CREATE (:Node:Challenge {`id`: 'challenge:fm-2', `label`: 'Lack of Grounding and Domain-Specific Robotic Knowledge', `teacher`: 'fm', `order`: 2, `section`: 'sec:ch-fm', `statement`: 'Feedback models suffer from “the absence of domain-specific robotic knowledge in pre-trained datasets” and “lack world grounding”; VLM-RM\'s authors trace its failures to “limited spatial reasoning ability or visually unrealistic environments that are far off-distribution for the VLM”.', `openQuestion`: 'How much of a robot\'s own camera data a feedback model needs to close this gap, and what general knowledge it loses, has not been measured.', `text`: 'Feedback models suffer from “the absence of domain-specific robotic knowledge in pre-trained datasets” and “lack world grounding”; VLM-RM\'s authors trace its failures to “limited spatial reasoning ability or visually unrealistic environments that are far off-distribution for the VLM”. The gap shows in perception: without its particle filter, T2-VLM\'s per-step Qwen2-VL-72B queries fell below 70% reward accuracy on three of four tasks because of occlusion, and the model missed the next-to relation on Make-line, while VLM-RM\'s humanoid reached 64% on “hands on hips” and 0% on “arms crossed”. It widens as feedback moves from outcomes to motion: in Li and Zhong\'s study on Robomimic Lift, every VLM scored 0.00 on action advising while preference accuracy reached 0.70–0.82, and over 1000 ObstructedMaze1Dlhb levels Llama3-70B produced no episode with every subgoal correct. Adapting the model narrows the gap at a price: MARVL fine-tunes its CLIP encoder on about 500 multi-view images, whereas T2-VLM judges such fine-tuning impractical for robotics. How much of a robot\'s own camera data a feedback model needs to close this gap, and what general knowledge it loses, has not been measured.', `version`: 'Section IX v4'});
CREATE (:Node:Challenge {`id`: 'challenge:fm-3', `label`: 'Reward Misspecification, Prompt Sensitivity and Reward Hacking', `teacher`: 'fm', `order`: 3, `section`: 'sec:ch-fm', `statement`: 'A foundation-model reward is only as good as its prompt: it “will be misspecified if the text description does not contain enough information about what the human intends”, and the models are “overly sensitive to prompt design”.', `openQuestion`: 'These exploits surfaced in rollouts or ablations; a monitor that flags during training a model reward rising while task progress stalls is missing.', `text`: 'A foundation-model reward is only as good as its prompt: it “will be misspecified if the text description does not contain enough information about what the human intends”, and the models are “overly sensitive to prompt design”. Removing the explanation from a one-example Ultimatum prompt cut GPT-3\'s labeling and RL agent accuracy by about 31.67% and 28.8%, and a shorter two-example ELLM prompt cut good Codex goals from 64.9% to 34.1%. Under optimization pressure, learners then find where the reward pays without progress. Motif reached about 30% success on the NetHack oracle task partly because the agent ate a yellow mold to hallucinate and the success check fired on a hallucinated oracle, a “misalignment by composition” of intrinsic and extrinsic rewards; ELLM rewarded stone mining without a pickaxe, and Lin et al.\'s potential-difference and direct LLM rewards were both hacked without a step penalty. Fixed offline labels fail as the policy moves: in Klissarov et al.\'s NetHack exploration task, offline preference labels led to a performance collapse that online querying avoided. These exploits surfaced in rollouts or ablations; a monitor that flags during training a model reward rising while task progress stalls is missing.', `version`: 'Section IX v4'});
CREATE (:Node:Challenge {`id`: 'challenge:fm-4', `label`: 'Computational Cost of Queries: When and How to Query', `teacher`: 'fm', `order`: 4, `section`: 'sec:ch-fm', `statement`: 'Querying a foundation model is costly: “Frequent VLM queries incur high computational costs, limiting scalability”, so approaches must “carefully determine when and how to query FMs”.', `openQuestion`: 'Whether such gating beats a fixed interval at equal cost in continuous control, within a robot\'s real-time loop, remains untested.', `text`: 'Querying a foundation model is costly: “Frequent VLM queries incur high computational costs, limiting scalability”, so approaches must “carefully determine when and how to query FMs”. Per-step querying makes the cost grow with training: Zhao et al.\'s per-step VLM baseline needed 872 and 1,620 queries on two tasks, against 200 for T2-VLM, and an uncached 5-million-step ELLM run would spend 27 hours querying and cost thousands of dollars. Usable feedback tends to need large models: ranking state pairs in grid worlds, Llama-3 8B scored 0.69, 0.54 and 0.58 against 1.0, 0.98 and 0.99 for GPT-4, and on Motif\'s oracle task only the 70B Llama 2 annotator found the oracle consistently, yet moving Perception-LM from 1B to 8B raised peak memory by 439% without consistent gain on DoorKey-16x16. Learners ration queries with fixed intervals, caches and quotas; Merler et al.\'s entropy gate, the only uncertainty-driven schedule, “limits the frequency of VLM queries” but still called Gemma-3-4B heavily early on. Whether such gating beats a fixed interval at equal cost in continuous control, within a robot\'s real-time loop, remains untested.', `version`: 'Section IX v4'});
CREATE (:Node:Challenge {`id`: 'challenge:fm-5', `label`: 'Limited and uneven robotics evidence', `teacher`: 'fm', `order`: 5, `section`: 'sec:ch-fm', `statement`: 'Robotics evidence spans simulation, offline learning from robot data, sim-to-real transfer and physical policy training. Reward accuracy checks alone do not establish policy learning.', `openQuestion`: 'Can physical training results be reproduced with multiple seeds, comparable resource budgets and less manual resetting?', `text`: 'Learning from foundation-model feedback has been shown in settings that “rely on simplified abstractions that fail to capture real-world complexity”. Many results depend on views prepared for the judge: VLM-RM\'s kneeling success rose from 36% with default textures and an agent-following camera to 91% with realistic textures and 100% with a fixed camera added, RL-VLM-F made the robot invisible, started the gripper near the target and re-centered the cameras, and ELLM\'s captions came from ground-truth state. Other pipelines need what only a simulator gives: Lin et al. sample consecutive state pairs at random, which they note holds in most simulated environments but is “violated in others such as the real world”, and AutoSkill “assumes access to the simulated environment for the new real-world scenario”. Where a physical robot appears, no learner learns on it online: ERL-VLM ran offline IQL on a Sawyer from demonstrations rated by Gemini-1.5-Pro, T2-VLM measured only reward accuracy on images of a real UR arm, and AutoSkill transferred simulation-trained policies to a UR3. Whether a feedback model keeps its accuracy and learning gain when a robot learns online from its own camera, with the arm in view and no resets, remains untested.', `version`: 'Section IX v4', `sourceUrl`: 'https://arxiv.org/html/2603.28730v2', `locator`: 'Section 5.3; Appendix G and I', `reviewedAt`: '2026-11-24'});
CREATE (:Node:DetailedChallenge {`id`: 'detail:human-1', `label`: 'Teacher reliability is assumed, not estimated', `teacher`: 'human', `stage`: 'The Teacher', `problem`: 'Learners presume a teacher whose errors are rare and occur at a known rate, although modest error rates are enough to cancel what the teacher contributes.', `openQuestion`: 'No reviewed work estimates a teacher\'s reliability online, and whether a learner can do so while separating teacher error from recognition error remains untested.', `layer`: 'optional detail', `status`: 'earlier stage-based Section IX (attached survey source); superseded by Section IX v4'});
CREATE (:Node:DetailedChallenge {`id`: 'detail:human-2', `label`: 'Teachers are biased, drifting and different', `teacher`: 'human', `stage`: 'The Teacher', `problem`: 'Learners assume one teacher with a fixed strategy, balanced valence and a shared target, whereas trainers differ from one another and change within a session.', `openQuestion`: 'Whether a learner can infer a trainer\'s valence bias, strategy and target online, and detect when they change, remains untested.', `layer`: 'optional detail', `status`: 'earlier stage-based Section IX (attached survey source); superseded by Section IX v4'});
CREATE (:Node:DetailedChallenge {`id`: 'detail:human-3', `label`: 'Feedback depends on the policy and on intent', `teacher`: 'human', `stage`: 'The Teacher', `problem`: 'Most learners treat a human evaluation as a stationary verdict on the last state–action pair, whereas people judge against the learner\'s progress and use the same channel to guide or motivate.', `openQuestion`: 'Whether a learner can infer from one channel if a signal judges the last action, the policy\'s trend or the next action, or only encourages, remains untested.', `layer`: 'optional detail', `status`: 'earlier stage-based Section IX (attached survey source); superseded by Section IX v4'});
CREATE (:Node:DetailedChallenge {`id`: 'detail:human-4', `label`: 'Recognition accuracy bounds the signal', `teacher`: 'human', `stage`: 'Perception and Timing of the Signal', `problem`: 'When a rating is read from a face, a voice or brain activity, each misrecognition enters the learner as reward noise, often of the wrong sign.', `openQuestion`: 'The overall and negative-feedback accuracy that a calibration-free recognition model of unprompted reactions on commodity sensors must reach for those reactions to help an online learner has not been measured.', `layer`: 'optional detail', `status`: 'earlier stage-based Section IX (attached survey source); superseded by Section IX v4'});
CREATE (:Node:DetailedChallenge {`id`: 'detail:human-5', `label`: 'Spontaneous reactions are the least tested', `teacher`: 'human', `stage`: 'Perception and Timing of the Signal', `problem`: 'The case that motivates reading feedback from reactions, a person reacting without intent to teach, is the one the reviewed works test least: such a reaction may not concern the agent and can start before or after the event.', `openQuestion`: 'Whether a learner can infer online if, when and to which event an unprompted reaction refers, from a person not watching it, remains untested.', `layer`: 'optional detail', `status`: 'earlier stage-based Section IX (attached survey source); superseded by Section IX v4'});
CREATE (:Node:DetailedChallenge {`id`: 'detail:human-6', `label`: 'Natural channels become fixed vocabularies', `teacher`: 'human', `stage`: 'Perception and Timing of the Signal', `problem`: 'Speech, gesture and free language spare non-experts a hardware interface, but most systems use them only once reduced to a predefined vocabulary with hand-coded meanings, and recognition or grounding errors then enter the reward or advice.', `openQuestion`: 'The recognition and grounding error rates at which free speech or gesture stops helping are unknown, and learning signal meanings during the task has been shown mainly by TICS, for predefined gestures.', `layer`: 'optional detail', `status`: 'earlier stage-based Section IX (attached survey source); superseded by Section IX v4'});
CREATE (:Node:DetailedChallenge {`id`: 'detail:human-7', `label`: 'Fusion is proposed more than built', `teacher`: 'human', `stage`: 'Perception and Timing of the Signal', `problem`: 'Combining channels is a remedy many reviewed works propose for unreliable recognition, occlusion and attribution, yet the implemented fusions join at most two channels, with rules that cannot tell sensor noise from a teacher whose signals conflict.', `openQuestion`: 'No reviewed work models the correlated errors of reactions that co-occur because they respond to the same event, or treats their disagreement as information about the teacher rather than as noise.', `layer`: 'optional detail', `status`: 'earlier stage-based Section IX (attached survey source); superseded by Section IX v4'});
CREATE (:Node:DetailedChallenge {`id`: 'detail:human-8', `label`: 'Delay and pace misplace the signal', `teacher`: 'human', `stage`: 'Perception and Timing of the Signal', `problem`: 'Human feedback arrives after the behavior it judges, with a delay that varies across trainers, tasks and states, and current learners handle it with constants tuned by hand or by slowing the agent to human speed.', `openQuestion`: 'No reviewed learner estimates a trainer\'s delay online, and whether results obtained in slowed environments hold at task speed is untested.', `layer`: 'optional detail', `status`: 'earlier stage-based Section IX (attached survey source); superseded by Section IX v4'});
CREATE (:Node:DetailedChallenge {`id`: 'detail:human-9', `label`: 'One label, little information', `teacher`: 'human', `stage`: 'What the Signal Can Say', `problem`: 'An evaluative label says whether the behavior shown was good, or which of two was better, but not why it failed, by how much, or what to do next.', `openQuestion`: 'Whether format, scale and judged unit should change during training, as White et al. propose, remains untested.', `layer`: 'optional detail', `status`: 'earlier stage-based Section IX (attached survey source); superseded by Section IX v4'});
CREATE (:Node:DetailedChallenge {`id`: 'detail:human-10', `label`: 'Informative feedback demands expertise', `teacher`: 'human', `stage`: 'What the Signal Can Say', `problem`: 'The more a signal prescribes, the more the teacher must know, articulate or perform, and in continuous action spaces the most accessible prescription, a correction, gives only a direction.', `openQuestion`: 'In the three continuous-action correction works reviewed here, the correction size is a fixed constant, and whether a learner can recover it from a non-expert\'s context or timing remains untested.', `layer`: 'optional detail', `status`: 'earlier stage-based Section IX (attached survey source); superseded by Section IX v4'});
CREATE (:Node:DetailedChallenge {`id`: 'detail:human-11', `label`: 'Human evaluation is not MDP reward', `teacher`: 'human', `stage`: 'The Learner', `problem`: 'Used as reward in an MDP, a human evaluation forces a discount with no good setting, and a reward model fitted to such evaluations is a weakly identified target that moves as feedback accumulates.', `openQuestion`: 'No reviewed work bounds how far a policy trained on a drifting human reward model can stray from its trainer\'s intent, and an objective that lets trainers teach goals without circuits beyond a near-MDP-optimal grid-world agent is missing.', `layer`: 'optional detail', `status`: 'earlier stage-based Section IX (attached survey source); superseded by Section IX v4'});
CREATE (:Node:DetailedChallenge {`id`: 'detail:human-12', `label`: 'From reactions to reward', `teacher`: 'human', `stage`: 'The Learner', `problem`: 'Most learners turn a recognized facial, vocal or EEG reaction into reward through a fixed table, usually binary valence, which limits what reaches the learner.', `openQuestion`: 'Whether a learner can infer online, for each person, how reactions relate to the advantage of the preceding action, and how little explicit feedback grounds that relation, remains untested.', `layer`: 'optional detail', `status`: 'earlier stage-based Section IX (attached survey source); superseded by Section IX v4'});
CREATE (:Node:DetailedChallenge {`id`: 'detail:human-13', `label`: 'Where feedback enters the learner', `teacher`: 'human', `stage`: 'The Learner', `problem`: 'Feedback can enter as reward, value, policy or action bias, with or without the environment reward, yet each route rests on hand-tuned weights and decays, and routes are rarely compared.', `openQuestion`: 'No reviewed work compares entry points across feedback levels on a common task, and whether a learner can choose its entry point online remains untested.', `layer`: 'optional detail', `status`: 'earlier stage-based Section IX (attached survey source); superseded by Section IX v4'});
CREATE (:Node:DetailedChallenge {`id`: 'detail:human-14', `label`: 'Feedback stays where it was given', `teacher`: 'human', `stage`: 'The Learner', `problem`: 'Human feedback usually applies only where it was given and reaches only states the agent visits; retaining or spreading it saves teacher effort but also spreads the teacher\'s mistakes.', `openQuestion`: 'The reach of each piece of feedback is set by hand, through cluster counts, thresholds or decay rates; a learner that estimates it with calibrated confidence across states, tasks and embodiments is missing.', `layer`: 'optional detail', `status`: 'earlier stage-based Section IX (attached survey source); superseded by Section IX v4'});
CREATE (:Node:DetailedChallenge {`id`: 'detail:human-15', `label`: 'Small, discrete, hand-built spaces', `teacher`: 'human', `stage`: 'The Learner', `problem`: 'Most methods that learn from human feedback are built and tested in tabular, bandit or discrete-action settings over hand-selected features, at a scale chosen partly to fit a human session.', `openQuestion`: 'Whether a robot can learn its state representation online from the interaction, without an offline simulator corpus and within one session\'s feedback budget, remains untested.', `layer`: 'optional detail', `status`: 'earlier stage-based Section IX (attached survey source); superseded by Section IX v4'});
CREATE (:Node:DetailedChallenge {`id`: 'detail:human-16', `label`: 'Feedback budgets and when to ask', `teacher`: 'human', `stage`: 'The Interaction Loop', `problem`: 'Reward learning from people needs more labels than one teacher gives in a session, and no criterion for when and what to ask is settled.', `openQuestion`: 'Selection by expected value of information appears in no reviewed method, and no criterion weighs a query\'s information against its cost to the teacher.', `layer`: 'optional detail', `status`: 'earlier stage-based Section IX (attached survey source); superseded by Section IX v4'});
CREATE (:Node:DetailedChallenge {`id`: 'detail:human-17', `label`: 'Teacher workload and fading feedback', `teacher`: 'human', `stage`: 'The Interaction Loop', `problem`: 'Teachers give most feedback early and then fade, while most learners assume a teacher present until convergence, and the effort a channel demands is seldom measured.', `openQuestion`: 'No reviewed study measures workload with the same instrument for an implicit channel and a keypress interface, so the lower load that motivates implicit feedback remains an assumption.', `layer`: 'optional detail', `status`: 'earlier stage-based Section IX (attached survey source); superseded by Section IX v4'});
CREATE (:Node:DetailedChallenge {`id`: 'detail:human-18', `label`: 'What the learner shows its teacher', `teacher`: 'human', `stage`: 'The Interaction Loop', `problem`: 'Teachers tune their feedback to what they believe the learner perceives and intends, yet few learners expose either, and what to display is unresolved.', `openQuestion`: 'No reviewed study compares a display of the learner\'s perceived state or intended action with one of its uncertainty, so which state to show, and when, without teachers optimizing the display itself, remains untested.', `layer`: 'optional detail', `status`: 'earlier stage-based Section IX (attached survey source); superseded by Section IX v4'});
CREATE (:Node:DetailedChallenge {`id`: 'detail:human-19', `label`: 'Stand-in teachers and thin human samples', `teacher`: 'human', `stage`: 'Evidence and Deployment', `problem`: 'Most quantitative evidence comes from teachers that are not people, or from few people under favorable conditions, so robustness and efficiency claims are rarely tested on the non-experts the methods target.', `openQuestion`: 'No reviewed work checks whether a simulated teacher ranks methods as people do, and none controls for trainer learning.', `layer`: 'optional detail', `status`: 'earlier stage-based Section IX (attached survey source); superseded by Section IX v4'});
CREATE (:Node:DetailedChallenge {`id`: 'detail:human-20', `label`: 'No common evaluation framework', `teacher`: 'human', `stage`: 'Evidence and Deployment', `problem`: 'Interactive RL has no shared tasks, interfaces or metrics of human cost, so results can rarely be compared or pooled.', `openQuestion`: 'No reviewed work defines a benchmark that fixes task, interface and human-cost metrics while letting feedback depend on the policy being learned, which Zhang et al. note a static dataset cannot capture.', `layer`: 'optional detail', `status`: 'earlier stage-based Section IX (attached survey source); superseded by Section IX v4'});
CREATE (:Node:DetailedChallenge {`id`: 'detail:human-21', `label`: 'Learning rarely reaches real robots', `teacher`: 'human', `stage`: 'Evidence and Deployment', `problem`: 'Most human-feedback methods are validated only in simulation, and when a robot appears it often runs a demonstration, a replay or a policy learned elsewhere rather than learning in closed loop from people.', `openQuestion`: 'Zhang et al. design for the trainer\'s absence, learning human and environment reward together because nobody can reward an underwater vehicle at sea, yet evaluated only in Gazebo with one trainer; whether a robot taught by people keeps learning once deliberate feedback stops is unanswered.', `layer`: 'optional detail', `status`: 'earlier stage-based Section IX (attached survey source); superseded by Section IX v4'});
CREATE (:Node:DetailedChallenge {`id`: 'detail:human-22', `label`: 'Unsafe exploration, manipulation and consent', `teacher`: 'human', `stage`: 'Safety and Ethics', `problem`: 'Learning from human feedback still explores by trial and error, the teacher expected to keep it safe offers no formal guarantee, and learning from reactions raises ethical questions the field has barely examined.', `openQuestion`: 'No reviewed work turns a teacher\'s feedback, vetoes included, into a constraint that holds when the teacher is wrong, slow or absent, and none specifies a disclosure protocol that obtains consent without removing the spontaneity of the reactions being learned from.', `layer`: 'optional detail', `status`: 'earlier stage-based Section IX (attached survey source); superseded by Section IX v4'});
CREATE (:Node:DetailedChallenge {`id`: 'detail:fm-1', `label`: 'Prompts are unvalidated objectives', `teacher`: 'fm', `stage`: 'The Teacher', `problem`: 'With a feedback model, the prompt is the objective: its wording and components decide what is rewarded, yet prompts are hand-written per task and rarely validated, and one that omits part of the intent misspecifies the reward.', `openQuestion`: 'Beyond Motif\'s single rewording, how much a learned policy varies across paraphrases of one description has not been measured.', `layer`: 'optional detail', `status`: 'earlier stage-based Section IX (attached survey source); superseded by Section IX v4'});
CREATE (:Node:DetailedChallenge {`id`: 'detail:fm-2', `label`: 'Usable feedback needs large or proprietary models', `teacher`: 'fm', `stage`: 'The Teacher', `problem`: 'Usable feedback often requires a large or proprietary model, yet gains from scale are uneven and hard to predict.', `openQuestion`: 'No reviewed work compares size, reasoning training and domain alignment as predictors of the learner\'s success.', `layer`: 'optional detail', `status`: 'earlier stage-based Section IX (attached survey source); superseded by Section IX v4'});
CREATE (:Node:DetailedChallenge {`id`: 'detail:fm-3', `label`: 'Adapting the feedback model has a price', `teacher`: 'fm', `stage`: 'The Teacher', `problem`: 'Adapting the feedback model is a common remedy for its gap to robot scenes, but it costs in-domain data and compute, gives up zero-shot use and may erode general knowledge.', `openQuestion`: 'No reviewed work varies the robot data spent on adaptation and measures both the gain in feedback accuracy and the loss of general knowledge.', `layer`: 'optional detail', `status`: 'earlier stage-based Section IX (attached survey source); superseded by Section IX v4'});
CREATE (:Node:DetailedChallenge {`id`: 'detail:fm-4', `label`: 'Fine spatial detail, occlusion and non-visual state', `teacher`: 'fm', `stage`: 'What the Teacher Perceives', `problem`: 'Feedback models grasp what a scene contains better than where its parts are, and judge only what the camera shows.', `openQuestion`: 'VLM-RB assumes that progress is visible, and every feedback model in Table II sees images, clips or text; whether sensing beyond vision, which ERL-VLM leaves to future work, lets a model judge what the camera cannot show remains untested.', `layer`: 'optional detail', `status`: 'earlier stage-based Section IX (attached survey source); superseded by Section IX v4'});
CREATE (:Node:DetailedChallenge {`id`: 'detail:fm-5', `label`: 'Judgments shift with rendering and viewpoint', `teacher`: 'fm', `stage`: 'What the Teacher Perceives', `problem`: 'A visual judge\'s verdict on an unchanged task state can shift with the rendering alone, and many reported results rely on simulator edits a robot\'s camera does not allow.', `openQuestion`: 'The inpainting RL-VLM-F would need on a real arm is untested, as is judge quality on a robot\'s camera with the arm in view and the viewpoint moving.', `layer`: 'optional detail', `status`: 'earlier stage-based Section IX (attached survey source); superseded by Section IX v4'});
CREATE (:Node:DetailedChallenge {`id`: 'detail:fm-6', `label`: 'Single frames lack temporal context', `teacher`: 'fm', `stage`: 'What the Teacher Perceives', `problem`: 'A single observation rarely shows whether a task is progressing, yet most feedback models judge one frame or state, and longer histories run into context limits.', `openQuestion`: 'No reviewed work compares clips, object trajectories and text summaries as the history given to a feedback model at equal token cost.', `layer`: 'optional detail', `status`: 'earlier stage-based Section IX (attached survey source); superseded by Section IX v4'});
CREATE (:Node:DetailedChallenge {`id`: 'detail:fm-7', `label`: 'Observation-to-text interfaces bound the reward', `teacher`: 'fm', `stage`: 'What the Teacher Perceives', `problem`: 'Text-based feedback needs an interface from observations to words, which reviewed works write by hand or build from simulator state, and which bounds what can be rewarded.', `openQuestion`: 'Whether accuracy and learning gain survive when captions and policy inputs come from robot camera images is untested.', `layer`: 'optional detail', `status`: 'earlier stage-based Section IX (attached survey source); superseded by Section IX v4'});
CREATE (:Node:DetailedChallenge {`id`: 'detail:fm-8', `label`: 'Hallucinated success and omitted goals', `teacher`: 'fm', `stage`: 'What the Teacher Perceives', `problem`: 'Feedback models assert events and success that their input does not show, and they omit goals or reject correct states, which are then never rewarded.', `openQuestion`: 'Whether a learner can estimate a feedback model\'s false-positive and false-negative rates separately during training, without labeled states, remains untested.', `layer`: 'optional detail', `status`: 'earlier stage-based Section IX (attached survey source); superseded by Section IX v4'});
CREATE (:Node:DetailedChallenge {`id`: 'detail:fm-9', `label`: 'Knowledge and reasoning limits', `teacher`: 'fm', `stage`: 'What the Teacher Perceives', `problem`: 'Foundation-model feedback is bounded by what the model knows about an environment and how well it applies that knowledge, both failing under unfamiliar rules and longer reasoning.', `openQuestion`: 'Whether a learner can detect during training that its feedback model answers outside its knowledge, and discount it, remains untested.', `layer`: 'optional detail', `status`: 'earlier stage-based Section IX (attached survey source); superseded by Section IX v4'});
CREATE (:Node:DetailedChallenge {`id`: 'detail:fm-10', `label`: 'Label noise of unknown rate', `teacher`: 'fm', `stage`: 'What the Signal Can Say', `problem`: 'Labels from a feedback model carry errors at an unknown rate, which learners absorb with fixed devices instead of estimating it.', `openQuestion`: 'Only Words as Beacons fits an error model of its LLM\'s subgoals, against an oracle; whether a learner can estimate errors per state during training, weighting each label accordingly, remains untested.', `layer`: 'optional detail', `status`: 'earlier stage-based Section IX (attached survey source); superseded by Section IX v4'});
CREATE (:Node:DetailedChallenge {`id`: 'detail:fm-11', `label`: 'Uncalibrated scores, little information per query', `teacher`: 'fm', `stage`: 'What the Signal Can Say', `problem`: 'Model scores lack a calibrated scale that rises with task progress, and formats that avoid calibration return about one bit per query and discard the model\'s confidence.', `openQuestion`: 'Whether answer likelihoods, proposed by Kwon et al. as graded rewards, can supply a calibrated scale and more information per query remains untested.', `layer`: 'optional detail', `status`: 'earlier stage-based Section IX (attached survey source); superseded by Section IX v4'});
CREATE (:Node:DetailedChallenge {`id`: 'detail:fm-12', `label`: 'Learners exploit model rewards', `teacher`: 'fm', `stage`: 'The Learner', `problem`: 'Under optimization pressure, learners find states that a foundation model scores highly without task progress, including loopholes opened by adding the model\'s reward to the task reward.', `openQuestion`: 'These exploits surfaced in rollouts or ablations; a monitor flagging during training a model reward that rises while progress stalls is missing.', `layer`: 'optional detail', `status`: 'earlier stage-based Section IX (attached survey source); superseded by Section IX v4'});
CREATE (:Node:DetailedChallenge {`id`: 'detail:fm-13', `label`: 'Stale offline labels, moving online rewards', `teacher`: 'fm', `stage`: 'The Learner', `problem`: 'A foundation-model reward fitted once to a fixed dataset knows only the states it covers, while one refreshed during training gives the learner a moving target.', `openQuestion`: 'Refresh periods are hand-set; whether a schedule can follow the policy\'s states while bounding how fast the target moves remains untested.', `layer`: 'optional detail', `status`: 'earlier stage-based Section IX (attached survey source); superseded by Section IX v4'});
CREATE (:Node:DetailedChallenge {`id`: 'detail:fm-14', `label`: 'Reward is the near-only entry point', `teacher`: 'fm', `stage`: 'The Learner', `problem`: 'Almost every reviewed method passes the foundation model\'s judgment to the learner as reward, an indirect channel for what to try next; value and policy shaping are absent.', `openQuestion`: 'Whether one judgment helps most as reward, action bias, value prior or replay priority, and whether the answer depends on its accuracy, remains untested.', `layer`: 'optional detail', `status`: 'earlier stage-based Section IX (attached survey source); superseded by Section IX v4'});
CREATE (:Node:DetailedChallenge {`id`: 'detail:fm-15', `label`: 'Model rewards need scaffolding', `teacher`: 'fm', `stage`: 'The Learner', `problem`: 'Foundation-model rewards often work only inside scaffolding: environment success reward at hand-picked weights, demonstrations, goal images and per-task thresholds.', `openQuestion`: 'Whether the weights and thresholds that admit a model reward can be set from the model\'s estimated reliability remains untested.', `layer`: 'optional detail', `status`: 'earlier stage-based Section IX (attached survey source); superseded by Section IX v4'});
CREATE (:Node:DetailedChallenge {`id`: 'detail:fm-16', `label`: 'Inaccurate low-level advice, ungrounded goals', `teacher`: 'fm', `stage`: 'The Learner', `problem`: 'Foundation-model feedback loses accuracy as it moves from comparing outcomes to prescribing motion, and goal guidance helps only where goals map onto skills the learner can acquire.', `openQuestion`: 'No reviewed work gives action advice to a learner controlling a continuous arm.', `layer`: 'optional detail', `status`: 'earlier stage-based Section IX (attached survey source); superseded by Section IX v4'});
CREATE (:Node:DetailedChallenge {`id`: 'detail:fm-17', `label`: 'Query cost grows with training', `teacher`: 'fm', `stage`: 'The Interaction Loop', `problem`: 'Querying a foundation model at every step, clip or episode makes queries, compute and price grow with training, and learners ration them with fixed rules whose cost is rarely reported.', `openQuestion`: 'Whether such gating beats a fixed interval at equal budget in continuous state spaces remains untested.', `layer`: 'optional detail', `status`: 'earlier stage-based Section IX (attached survey source); superseded by Section IX v4'});
CREATE (:Node:DetailedChallenge {`id`: 'detail:fm-18', `label`: 'Limited physical robot training evidence', `teacher`: 'fm', `stage`: 'Evidence and Deployment', `problem`: 'Foundation-model feedback has supported offline RL from robot data, sim-to-real transfer and physical training of a new policy. These are different kinds of evidence.', `openQuestion`: 'How reliably do gains persist across tasks, cameras and training seeds when reset labour, reward-model preparation and safety constraints are reported?', `layer`: 'optional detail', `status`: 'earlier stage-based Section IX (attached survey source); superseded by Section IX v4', `sourceUrl`: 'https://arxiv.org/html/2603.28730v2', `locator`: 'Section 5.3; Appendix G and I', `reviewedAt`: '2026-11-24'});
CREATE (:Node:DetailedChallenge {`id`: 'detail:fm-19', `label`: 'Judge accuracy unmeasured or unlinked to gain', `teacher`: 'fm', `stage`: 'Evidence and Deployment', `problem`: 'A feedback model\'s error rate often goes unmeasured, and where it is measured, it can diverge from what the learner gains.', `openQuestion`: 'How much feedback error of each kind a learner tolerates in continuous control remains untested.', `layer`: 'optional detail', `status`: 'earlier stage-based Section IX (attached survey source); superseded by Section IX v4'});
CREATE (:Node:DetailedChallenge {`id`: 'detail:fm-20', `label`: 'Thin, confounded evaluation', `teacher`: 'fm', `stage`: 'Evidence and Deployment', `problem`: 'Results with foundation-model feedback rest on few tasks, seeds and learners, on simple or hand-picked benchmarks, and on uneven comparisons.', `openQuestion`: 'No reviewed work evaluates on a benchmark that combines continuous control, controlled teacher error and equal tuning for every reward source.', `layer`: 'optional detail', `status`: 'earlier stage-based Section IX (attached survey source); superseded by Section IX v4'});
CREATE (:Node:DetailedChallenge {`id`: 'detail:fm-21', `label`: 'Inherited bias, post-hoc safety', `teacher`: 'fm', `stage`: 'Safety and Bias', `problem`: 'A feedback model\'s biases, from social stereotypes to label preferences, can pass through the reward into the policy; the reviewed works name this risk without measuring it and leave safety to post-hoc checks.', `openQuestion`: 'No reviewed work measures how much of a feedback model\'s label bias survives into the reward and the policy, and none enforces safety during learning rather than inspecting the trained agent afterwards.', `layer`: 'optional detail', `status`: 'earlier stage-based Section IX (attached survey source); superseded by Section IX v4'});
CREATE (:Node:Work {`id`: 'work:luo_precise_2025', `label`: 'HIL-SERL', `key`: 'luo_precise_2025', `short`: 'HIL-SERL', `title`: 'Precise and Dexterous Robotic Manipulation via Human-in-the-Loop Reinforcement Learning', `year`: '2025', `authorYear`: 'Luo 2025', `teacher`: 'human', `scope`: 'robotics review', `discussedIn`: ['sec:robotics'], `sourceUrl`: 'https://arxiv.org/html/2410.21845v3', `sourceId`: 'P063', `reviewStatus`: 'Experiment-level robotics review available; legacy classifications retain their own provenance.'});
