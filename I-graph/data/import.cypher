// Load the survey graph into Neo4j: paste this file into Neo4j Browser or run it with cypher-shell.
CREATE CONSTRAINT node_id IF NOT EXISTS FOR (n:Node) REQUIRE n.id IS UNIQUE;
CREATE (:Node:TeacherType {`id`: 'teacher:human', `label`: 'Human'});
CREATE (:Node:TeacherType {`id`: 'teacher:fm', `label`: 'Foundation model (LLM/VLM)'});
CREATE (:Node:TeacherKind {`id`: 'teacherkind:people', `label`: 'People', `definition`: 'Feedback given by people through an interface or read from their reactions.'});
CREATE (:Node:TeacherKind {`id`: 'teacherkind:standin', `label`: 'Stand-in for people', `definition`: 'Simulated user or oracle, synthetic or scripted labels, recorded human feedback or an agent trainer used in place of a person (Table I, Channel column).'});
CREATE (:Node:FeedbackType {`id`: 'ftype:evaluative', `label`: 'Evaluative', `definition`: 'The teacher judges a behavior it is shown (Section V).'});
CREATE (:Node:FeedbackType {`id`: 'ftype:informative', `label`: 'Informative', `definition`: 'The teacher prescribes the behavior to perform (Section V).'});
CREATE (:Node:FeedbackLevel {`id`: 'level:rating', `label`: 'Rating', `definition`: 'Judges one behavior on an absolute scale: binary, graded or ordered classes.', `feedbackType`: 'evaluative'});
CREATE (:Node:FeedbackLevel {`id`: 'level:preference', `label`: 'Preference', `definition`: 'Compares two or more behaviors and says which is better.', `feedbackType`: 'evaluative'});
CREATE (:Node:FeedbackLevel {`id`: 'level:action', `label`: 'Action', `definition`: 'Fixes the action or how to change it: an action, a correction or a rule.', `feedbackType`: 'informative'});
CREATE (:Node:FeedbackLevel {`id`: 'level:goal', `label`: 'Goal', `definition`: 'Fixes only what to reach or act upon: a state, object, subgoal or skill.', `feedbackType`: 'informative'});
CREATE (:Node:ChannelClass {`id`: 'chclass:explicit', `label`: 'Explicit', `definition`: 'Given on purpose through an interface or in words (human teachers only).'});
CREATE (:Node:ChannelClass {`id`: 'chclass:implicit', `label`: 'Implicit', `definition`: 'Read from the teacher\'s reactions (face, voice, brain activity) by a perception model (human teachers only).'});
CREATE (:Node:IntegrationMethod {`id`: 'integ:RS', `label`: 'Reward shaping', `code`: 'RS', `definedBy`: 'najar_reinforcement_2021'});
CREATE (:Node:IntegrationMethod {`id`: 'integ:VS', `label`: 'Value shaping', `code`: 'VS', `definedBy`: 'najar_reinforcement_2021'});
CREATE (:Node:IntegrationMethod {`id`: 'integ:PS', `label`: 'Policy shaping', `code`: 'PS', `definedBy`: 'najar_reinforcement_2021'});
CREATE (:Node:IntegrationMethod {`id`: 'integ:DB', `label`: 'Decision biasing', `code`: 'DB', `definedBy`: 'najar_reinforcement_2021'});
CREATE (:Node:IntegrationMethod {`id`: 'integ:PB', `label`: 'Potential-based shaping', `code`: 'PB', `definedBy`: 'this survey (Table II)'});
CREATE (:Node:IntegrationMethod {`id`: 'integ:EG', `label`: 'Experience guidance (replay priority)', `code`: 'EG', `definedBy`: 'this survey (Table II)'});
CREATE (:Node:IntegrationMethod {`id`: 'integ:TP', `label`: 'Task proposal', `code`: 'Task proposal', `definedBy`: 'this survey (Table II)'});
CREATE (:Node:FeedbackModeling {`id`: 'modeling:MF', `label`: 'Model-free (feedback used directly)', `code`: 'MF', `note`: 'Survey sense: MF/MB qualify how a shaping method uses feedback, not whether the RL learner is model-based.'});
CREATE (:Node:FeedbackModeling {`id`: 'modeling:MB', `label`: 'Model-based (model of the teacher\'s feedback learned first)', `code`: 'MB', `note`: 'Survey sense: MF/MB qualify how a shaping method uses feedback, not whether the RL learner is model-based.'});
CREATE (:Node:EnvRewardUse {`id`: 'env:used', `label`: 'Environment reward used'});
CREATE (:Node:EnvRewardUse {`id`: 'env:notused', `label`: 'Environment reward not used'});
CREATE (:Node:EnvRewardUse {`id`: 'env:nr', `label`: 'Not reported'});
CREATE (:Node:EnvRewardUse {`id`: 'env:na', `label`: 'Not applicable'});
CREATE (:Node:FeedbackRegime {`id`: 'regime:online', `label`: 'Online: judges the learner\'s own behavior during training'});
CREATE (:Node:FeedbackRegime {`id`: 'regime:offline', `label`: 'Offline: labels data collected before training'});
CREATE (:Node:FeedbackRegime {`id`: 'regime:none', `label`: 'No behavior judged (advice or goals from the state or task)'});
CREATE (:Node:FMInput {`id`: 'input:image', `label`: 'Image'});
CREATE (:Node:FMInput {`id`: 'input:clip', `label`: 'Video clip'});
CREATE (:Node:FMInput {`id`: 'input:text', `label`: 'Text (caption, state or episode text)'});
CREATE (:Node:ExclusionCategory {`id`: 'excl:reward-code', `label`: 'Excluded: reward-code generation', `reason`: 'The LLM writes a reward program once or between training runs; it never judges behavior as it occurs.'});
CREATE (:Node:ExclusionCategory {`id`: 'excl:fm-policy', `label`: 'Excluded: foundation model as the policy', `reason`: 'The foundation model is itself the policy, so there is no separate learner to receive feedback.'});
CREATE (:Node:FeedbackForm {`id`: 'form:binary', `label`: 'Binary'});
CREATE (:Node:FeedbackForm {`id`: 'form:ternary', `label`: 'Ternary'});
CREATE (:Node:FeedbackForm {`id`: 'form:nclass', `label`: 'n-class (ordered labels)'});
CREATE (:Node:FeedbackForm {`id`: 'form:scalar', `label`: 'Scalar (graded)'});
CREATE (:Node:FeedbackForm {`id`: 'form:pairwise', `label`: 'Pairwise'});
CREATE (:Node:FeedbackForm {`id`: 'form:similarity', `label`: 'Similarity (embedding cosine)'});
CREATE (:Node:FeedbackForm {`id`: 'form:action-label', `label`: 'Action label'});
CREATE (:Node:FeedbackForm {`id`: 'form:correction', `label`: 'Correction'});
CREATE (:Node:FeedbackForm {`id`: 'form:target-position', `label`: 'Target position'});
CREATE (:Node:FeedbackForm {`id`: 'form:rule', `label`: 'Rule'});
CREATE (:Node:FeedbackForm {`id`: 'form:target', `label`: 'Target (object or region)'});
CREATE (:Node:FeedbackForm {`id`: 'form:free-form', `label`: 'Free-form language'});
CREATE (:Node:FeedbackForm {`id`: 'form:unlabeled-gesture', `label`: 'Unlabeled gesture'});
CREATE (:Node:FeedbackForm {`id`: 'form:goal-list', `label`: 'Goal or subgoal list'});
CREATE (:Node:FeedbackForm {`id`: 'form:skill-chain', `label`: 'Skill chain'});
CREATE (:Node:Channel {`id`: 'channel:mouse', `label`: 'Mouse', `channelClass`: 'explicit', `standIn`: false});
